// Package clients is the resilient service-to-service HTTP client: timeouts,
// exponential-backoff retries of idempotent requests, a circuit breaker,
// optional bearer auth, and propagation of the request correlation id and
// caller identity, like the Python ServiceClient. Redirects are not followed.
//
//	knowledge, err := clients.New(clients.Config{
//		BaseURL:     "http://knowledge:5002",
//		ServiceName: "knowledge",
{%- if platform_auth %}
//		Auth:        clients.PlatformAuth(s2s), // or clients.KeycloakClientCredentials(...)
{%- else %}
//		Auth:        clients.KeycloakClientCredentials("http://keycloak:8080", "app", "svc-orders", secret),
{%- endif %}
//	})
//	var hits []Hit
//	err = knowledge.Do(ctx, clients.Request{Method: http.MethodGet, Path: "/api/v1/search",
//		Query: url.Values{"q": {query}}}, &hits)
