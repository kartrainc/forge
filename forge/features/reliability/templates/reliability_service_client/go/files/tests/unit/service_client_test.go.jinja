func fastRetry(maxRetries int) *clients.RetryPolicy {
	return &clients.RetryPolicy{MaxRetries: maxRetries, BaseDelay: time.Millisecond, MaxDelay: 2 * time.Millisecond}
}

func newServiceClient(t *testing.T, server *httptest.Server, cfg clients.Config) *clients.ServiceClient {
	t.Helper()
	cfg.BaseURL = server.URL + "/"
	cfg.ServiceName = "knowledge"
	if cfg.Retry == nil {
		cfg.Retry = fastRetry(2)
	}
	client, err := clients.New(cfg)
	if err != nil {
		t.Fatal(err)
	}
	return client
}

// countingServer answers with respond and counts the requests it receives.
func countingServer(t *testing.T, respond http.HandlerFunc) (*httptest.Server, *atomic.Int32) {
	t.Helper()
	calls := &atomic.Int32{}
	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		calls.Add(1)
		respond(w, r)
	}))
	t.Cleanup(server.Close)
	return server, calls
}

func statusHandler(status int, body string) http.HandlerFunc {
	return func(w http.ResponseWriter, _ *http.Request) {
		w.WriteHeader(status)
		_, _ = w.Write([]byte(body))
	}
}

func asServiceCallError(t *testing.T, err error) *clients.ServiceCallError {
	t.Helper()
	var callErr *clients.ServiceCallError
	if !errors.As(err, &callErr) {
		t.Fatalf("want a *ServiceCallError, got %T: %v", err, err)
	}
	return callErr
}

func TestServiceClientPropagatesContextAndDecodes(t *testing.T) {
	var seen http.Header
	var seenBody string
	server, _ := countingServer(t, func(w http.ResponseWriter, r *http.Request) {
		seen = r.Header.Clone()
		raw, _ := io.ReadAll(r.Body)
		seenBody = string(raw)
		if r.URL.Path != "/api/v1/search" || r.URL.Query().Get("q") != "go" || r.URL.Query().Get("page") != "2" {
			w.WriteHeader(http.StatusBadRequest)
			return
		}
		_ = json.NewEncoder(w).Encode(map[string]any{"hits": []string{"a"}})
	})
	client := newServiceClient(t, server, clients.Config{IdentityHeaders: clients.IdentityHeaders{TenantSlug: "x-org"}})
	tenant := uuid.New()
	var result struct {
		Hits []string `json:"hits"`
	}
	var callErr error
	handler := middleware.Correlation(http.HandlerFunc(func(_ http.ResponseWriter, r *http.Request) {
		ctx := identity.WithContext(r.Context(), identity.IdentityContext{TenantID: tenant, Subject: "user-1", TenantSlug: "acme"})
		callErr = client.Do(ctx, clients.Request{
			Method: http.MethodPost,
			Path:   "/api/v1/search?q=go",
			Query:  url.Values{"page": {"2"}},
			Header: http.Header{"X-User-Id": {"spoofed"}, "Idempotency-Key": {"k1"}},
			Body:   map[string]string{"q": "go"},
		}, &result)
	}))
	request := httptest.NewRequest(http.MethodGet, "/", nil)
	request.Header.Set(middleware.RequestIDHeader, "req-42")
	handler.ServeHTTP(httptest.NewRecorder(), request)

	if callErr != nil || len(result.Hits) != 1 {
		t.Fatalf("call: %v %+v", callErr, result)
	}
	want := map[string]string{
		"X-Request-Id":    "req-42",
		"X-Customer-Id":   tenant.String(),
		"X-User-Id":       "user-1",
		"X-Org":           "acme",
		"Idempotency-Key": "k1",
		"Content-Type":    "application/json",
		"Authorization":   "",
	}
	for name, value := range want {
		if seen.Get(name) != value {
			t.Fatalf("header %s = %q, want %q", name, seen.Get(name), value)
		}
	}
	if seenBody != `{"q":"go"}` || client.ServiceName() != "knowledge" {
		t.Fatalf("body %q", seenBody)
	}
}

func TestServiceClientVerbs(t *testing.T) {
	var propagated atomic.Bool
	server, _ := countingServer(t, func(w http.ResponseWriter, r *http.Request) {
		if r.Header.Get("X-Customer-Id") != "" || r.Header.Get("X-Request-Id") != "" {
			propagated.Store(true)
		}
		if r.Method == http.MethodDelete {
			w.WriteHeader(http.StatusNoContent)
			return
		}
		_ = json.NewEncoder(w).Encode(map[string]string{"method": r.Method})
	})
	client := newServiceClient(t, server, clients.Config{Timeout: 5 * time.Second})
	ctx := context.Background()
	calls := map[string]func(out any) error{
		http.MethodGet:   func(out any) error { return client.Get(ctx, "/things/1", out) },
		http.MethodPost:  func(out any) error { return client.Post(ctx, "/things", map[string]int{"n": 1}, out) },
		http.MethodPut:   func(out any) error { return client.Put(ctx, "/things/1", map[string]int{"n": 2}, out) },
		http.MethodPatch: func(out any) error { return client.Patch(ctx, "/things/1", map[string]int{"n": 3}, out) },
	}
	for method, call := range calls {
		var echoed struct {
			Method string `json:"method"`
		}
		if err := call(&echoed); err != nil || echoed.Method != method {
			t.Fatalf("%s: %v %q", method, err, echoed.Method)
		}
	}
	untouched := map[string]string{"kept": "yes"}
	if err := client.Delete(ctx, "/things/1", &untouched); err != nil || untouched["kept"] != "yes" {
		t.Fatalf("204 decodes nothing: %v %v", err, untouched)
	}
	if err := client.Get(ctx, "/things/1", nil); err != nil {
		t.Fatalf("a nil target skips decoding: %v", err)
	}
	if propagated.Load() {
		t.Fatal("nothing is propagated without a bound identity or correlation id")
	}
}

func TestServiceClientRetriesServerErrors(t *testing.T) {
	var attempts atomic.Int32
	server, calls := countingServer(t, func(w http.ResponseWriter, _ *http.Request) {
		if attempts.Add(1) < 3 {
			w.WriteHeader(http.StatusServiceUnavailable)
			return
		}
		_, _ = w.Write([]byte(`{"ok":true}`))
	})
	var result struct {
		OK bool `json:"ok"`
	}
	if err := newServiceClient(t, server, clients.Config{}).Get(context.Background(), "/flaky", &result); err != nil || !result.OK {
		t.Fatalf("recovers on the third attempt: %v", err)
	}
	if calls.Load() != 3 {
		t.Fatalf("attempts %d", calls.Load())
	}
}

func TestServiceClientMapsExhaustedRetries(t *testing.T) {
	server, calls := countingServer(t, statusHandler(http.StatusInternalServerError, "down"))
	err := newServiceClient(t, server, clients.Config{}).Get(context.Background(), "/x", nil)
	callErr := asServiceCallError(t, err)
	if callErr.StatusCode != 500 || callErr.Body != "down" || callErr.Method != http.MethodGet ||
		callErr.URL != server.URL+"/x" || callErr.Service != "knowledge" || calls.Load() != 3 {
		t.Fatalf("one attempt plus two retries, then the 500 is reported: %+v calls=%d", callErr, calls.Load())
	}
	var status *clients.StatusError
	if !errors.As(err, &status) || status.Error() != "HTTP 500" || !strings.HasSuffix(err.Error(), "GET "+server.URL+"/x -> 500") {
		t.Fatalf("error text %q", err.Error())
	}
}

