func TestServiceClientCapsDecodedResponses(t *testing.T) {
	name := strings.Repeat("x", 64)
	server, calls := countingServer(t, statusHandler(http.StatusOK, `{"name":"`+name+`"}`))
	var out map[string]string
	err := newServiceClient(t, server, clients.Config{MaxResponseBytes: 32}).Get(context.Background(), "/x", &out)
	var tooLarge *http.MaxBytesError
	if !errors.As(err, &tooLarge) || tooLarge.Limit != 32 || asServiceCallError(t, err).StatusCode != 0 || calls.Load() != 1 {
		t.Fatalf("a body over MaxResponseBytes is final: %v calls=%d", err, calls.Load())
	}
	if err := newServiceClient(t, server, clients.Config{}).Get(context.Background(), "/x", &out); err != nil || out["name"] != name {
		t.Fatalf("the default cap decodes ordinary bodies: %v", err)
	}
}

func TestServiceClientDoesNotFollowRedirects(t *testing.T) {
	elsewhere, leaked := countingServer(t, statusHandler(http.StatusNoContent, ""))
	server, _ := countingServer(t, func(w http.ResponseWriter, r *http.Request) {
		http.Redirect(w, r, elsewhere.URL+"/collect", http.StatusTemporaryRedirect)
	})
	ctx := identity.WithContext(context.Background(), identity.IdentityContext{TenantID: uuid.New(), Subject: "user-1"})
	client := newServiceClient(t, server, clients.Config{Auth: staticToken{token: "secret"}})
	err := client.Post(ctx, "/x", map[string]int{"n": 1}, nil)
	if callErr := asServiceCallError(t, err); callErr.StatusCode != http.StatusTemporaryRedirect || leaked.Load() != 0 {
		t.Fatalf("a redirect fails the call without leaving the host: %v leaked=%d", err, leaked.Load())
	}
	following := newServiceClient(t, server, clients.Config{HTTPClient: &http.Client{}})
	if err := following.Get(ctx, "/x", nil); err != nil || leaked.Load() != 1 {
		t.Fatalf("a caller-provided client keeps its redirect policy: %v leaked=%d", err, leaked.Load())
	}
}

func TestServiceClientKeepsCallsOnTheBaseHost(t *testing.T) {
	server, calls := countingServer(t, func(w http.ResponseWriter, r *http.Request) {
		if r.Host != "knowledge" {
			w.WriteHeader(http.StatusMisdirectedRequest)
			return
		}
		w.WriteHeader(http.StatusNoContent)
	})
	var dialer net.Dialer
	transport := &http.Transport{DialContext: func(ctx context.Context, network, _ string) (net.Conn, error) {
		return dialer.DialContext(ctx, network, server.Listener.Addr().String())
	}}
	t.Cleanup(transport.CloseIdleConnections)
	client, err := clients.New(clients.Config{BaseURL: "http://knowledge", ServiceName: "knowledge", Retry: fastRetry(0),
		HTTPClient: &http.Client{Transport: transport}})
	if err != nil {
		t.Fatal(err)
	}
	for _, path := range []string{"@evil.example/x", ".evil.example/x", ":8080/x", "x", ""} {
		err := client.Get(context.Background(), path, nil)
		if callErr := asServiceCallError(t, err); callErr.StatusCode != 0 || !strings.Contains(err.Error(), "must start with /") {
			t.Fatalf("path %q is rejected: %v", path, err)
		}
	}
	if calls.Load() != 0 {
		t.Fatalf("rejected paths send nothing: %d calls", calls.Load())
	}
	for _, path := range []string{"//evil.example/x", "/@evil.example/x", "/x?next=http://evil.example/"} {
		if err := client.Get(context.Background(), path, nil); err != nil {
			t.Fatalf("path %q stays on the base host: %v", path, err)
		}
	}
}

type recordingBreaker struct {
	failures  atomic.Int32
	successes atomic.Int32
}

func (b *recordingBreaker) Call(op func() error) error {
	err := op()
	if err != nil {
		b.failures.Add(1)
	} else {
		b.successes.Add(1)
	}
	return err
}

func TestServiceClientBreakerCountsOnlyServiceFailures(t *testing.T) {
	server, _ := countingServer(t, func(w http.ResponseWriter, r *http.Request) {
		status, _ := strconv.Atoi(r.URL.Query().Get("status"))
		if status == 0 {
			<-r.Context().Done()
			return
		}
		w.WriteHeader(status)
	})
	breaker := &recordingBreaker{}
	client := newServiceClient(t, server, clients.Config{Breaker: breaker, Retry: fastRetry(0)})
	call := func(ctx context.Context, method string, status int) error {
		return client.Do(ctx, clients.Request{Method: method, Path: "/x", Query: url.Values{"status": {strconv.Itoa(status)}}}, nil)
	}
	for _, status := range []int{404, 404, 404, 404, 404, 409, 429, 302} {
		if err := call(context.Background(), http.MethodGet, status); asServiceCallError(t, err).StatusCode != status {
			t.Fatalf("status %d: %v", status, err)
		}
	}
	impatient, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
	defer cancel()
	if err := call(impatient, http.MethodGet, 0); !errors.Is(err, context.DeadlineExceeded) {
		t.Fatalf("the caller gives up: %v", err)
	}
	if breaker.failures.Load() != 0 || breaker.successes.Load() != 9 {
		t.Fatalf("4xx, 3xx and cancelled calls never count: failures=%d successes=%d", breaker.failures.Load(), breaker.successes.Load())
	}
	if err := call(context.Background(), http.MethodPost, 503); asServiceCallError(t, err).StatusCode != 503 || breaker.failures.Load() != 1 {
		t.Fatalf("a 5xx counts whatever the method: %v failures=%d", err, breaker.failures.Load())
	}
	closed := httptest.NewServer(http.NotFoundHandler())
	closed.Close()
	unreachable, err := clients.New(clients.Config{BaseURL: closed.URL, ServiceName: "knowledge", Breaker: breaker, Retry: fastRetry(0)})
	if err != nil {
		t.Fatal(err)
	}
	if err := unreachable.Get(context.Background(), "/x", nil); err == nil || breaker.failures.Load() != 2 {
		t.Fatalf("a refused connection counts: %v failures=%d", err, breaker.failures.Load())
	}
}

type rejectingBreaker struct{}

func (rejectingBreaker) Call(func() error) error { return errors.New("breaker says no") }

