func TestServiceClientStopsRetryingWhenCancelled(t *testing.T) {
	ctx, cancel := context.WithCancel(context.Background())
	defer cancel()
	server, calls := countingServer(t, statusHandler(http.StatusServiceUnavailable, ""))
	slow := &clients.RetryPolicy{MaxRetries: 3, BaseDelay: time.Hour, MaxDelay: time.Hour}
	client := newServiceClient(t, server, clients.Config{Retry: slow})
	time.AfterFunc(20*time.Millisecond, cancel)
	started := time.Now()
	err := client.Get(ctx, "/x", nil)
	if asServiceCallError(t, err).StatusCode != 503 || !errors.Is(err, context.Canceled) || time.Since(started) > 10*time.Second {
		t.Fatalf("a cancelled backoff reports the cancellation and keeps the last error: %v", err)
	}
	if err := client.Get(ctx, "/x", nil); err == nil || calls.Load() != 1 {
		t.Fatalf("a cancelled context is never retried: %v calls=%d", err, calls.Load())
	}
}

func TestServiceClientRejectsBadRequestsAndResponses(t *testing.T) {
	server, calls := countingServer(t, statusHandler(http.StatusOK, "not json"))
	client := newServiceClient(t, server, clients.Config{HTTPClient: server.Client()})
	var out map[string]any
	if err := client.Get(context.Background(), "/x", &out); asServiceCallError(t, err).StatusCode != 0 || calls.Load() != 1 {
		t.Fatalf("an undecodable body is final: %v calls=%d", err, calls.Load())
	}
	var unsupported *json.UnsupportedTypeError
	if err := client.Post(context.Background(), "/x", make(chan int), nil); !errors.As(err, &unsupported) {
		t.Fatalf("an unencodable body never leaves: %v", err)
	}
	if err := client.Do(context.Background(), clients.Request{Method: "BAD METHOD", Path: "/x"}, nil); err == nil {
		t.Fatal("an invalid method fails")
	}
	for _, cfg := range []clients.Config{
		{BaseURL: "knowledge:5002", ServiceName: "knowledge"},
		{BaseURL: "ftp://knowledge", ServiceName: "knowledge"},
		{BaseURL: "http://knowledge:5002"},
		{BaseURL: "http://knowledge:5002/api?v=1", ServiceName: "knowledge"},
		{BaseURL: "http://knowledge:5002#top", ServiceName: "knowledge"},
	} {
		if _, err := clients.New(cfg); err == nil {
			t.Fatalf("invalid config accepted: %+v", cfg)
		}
	}
}

func TestServiceClientBackoffAndRetryable(t *testing.T) {
	policy := clients.RetryPolicy{BaseDelay: 100 * time.Millisecond, MaxDelay: 250 * time.Millisecond}
	if policy.Backoff(0) != 100*time.Millisecond || policy.Backoff(1) != 200*time.Millisecond || policy.Backoff(5) != 250*time.Millisecond {
		t.Fatalf("exponential and capped: %v %v %v", policy.Backoff(0), policy.Backoff(1), policy.Backoff(5))
	}
	policy.Jitter = true
	for range 50 {
		if delay := policy.Backoff(0); delay < 50*time.Millisecond || delay >= 150*time.Millisecond {
			t.Fatalf("jitter scales by 0.5-1.5: %v", delay)
		}
	}
	if defaults := clients.DefaultRetryPolicy(); defaults.MaxRetries != 3 || defaults.BaseDelay != 500*time.Millisecond ||
		defaults.MaxDelay != 30*time.Second || !defaults.Jitter {
		t.Fatalf("defaults %+v", defaults)
	}
	get := clients.Request{Method: http.MethodGet}
	post := clients.Request{Method: http.MethodPost}
	keyed := clients.Request{Method: http.MethodPost, Header: http.Header{clients.IdempotencyKeyHeader: {"k1"}}}
	cases := []struct {
		request clients.Request
		err     error
		want    bool
	}{
		{get, &clients.StatusError{StatusCode: 503}, true},
		{get, &clients.StatusError{StatusCode: 429}, true},
		{get, &clients.StatusError{StatusCode: 409}, false},
		{get, context.Canceled, false},
		{get, &net.OpError{Op: "dial", Err: errors.New("refused")}, true},
		{get, &net.OpError{Op: "read", Err: os.ErrDeadlineExceeded}, true},
		{get, &net.OpError{Op: "read", Err: errors.New("connection reset by peer")}, false},
		{get, &url.Error{Op: "Get", URL: "/", Err: &tls.CertificateVerificationError{Err: errors.New("unknown authority")}}, false},
		{get, errors.New("decode failed"), false},
		{clients.Request{Method: http.MethodHead}, &clients.StatusError{StatusCode: 502}, true},
		{clients.Request{Method: http.MethodOptions}, &clients.StatusError{StatusCode: 502}, true},
		{clients.Request{Method: http.MethodDelete}, &clients.StatusError{StatusCode: 502}, true},
		{post, &clients.StatusError{StatusCode: 503}, false},
		{post, &net.OpError{Op: "dial", Err: errors.New("refused")}, false},
		{clients.Request{Method: http.MethodPatch}, &clients.StatusError{StatusCode: 503}, false},
		{keyed, &clients.StatusError{StatusCode: 503}, true},
	}
	for _, tc := range cases {
		if clients.DefaultRetryable(tc.request, tc.err) != tc.want {
			t.Fatalf("DefaultRetryable(%s, %v) != %v", tc.request.Method, tc.err, tc.want)
		}
	}
	server, calls := countingServer(t, statusHandler(http.StatusBadGateway, ""))
	never := &clients.RetryPolicy{MaxRetries: 3, BaseDelay: time.Millisecond, Retryable: func(clients.Request, error) bool { return false }}
	if err := newServiceClient(t, server, clients.Config{Retry: never}).Get(context.Background(), "/x", nil); err == nil || calls.Load() != 1 {
		t.Fatalf("a custom predicate decides: %v calls=%d", err, calls.Load())
	}
	posts := &clients.RetryPolicy{MaxRetries: 1, BaseDelay: time.Millisecond, Retryable: func(request clients.Request, _ error) bool {
		return request.Method == http.MethodPost
	}}
	if err := newServiceClient(t, server, clients.Config{Retry: posts}).Post(context.Background(), "/x", nil, nil); err == nil || calls.Load() != 3 {
		t.Fatalf("the predicate sees the request: %v calls=%d", err, calls.Load())
	}
}

func TestServiceClientRetriesOnlyIdempotentRequests(t *testing.T) {
	server, calls := countingServer(t, statusHandler(http.StatusServiceUnavailable, ""))
	client := newServiceClient(t, server, clients.Config{})
	cases := []struct {
		request  clients.Request
		attempts int32
	}{
		{clients.Request{Method: http.MethodPost, Path: "/x"}, 1},
		{clients.Request{Method: http.MethodPatch, Path: "/x"}, 1},
		{clients.Request{Method: http.MethodPost, Path: "/x", Header: http.Header{"Idempotency-Key": {"k1"}}}, 3},
		{clients.Request{Path: "/x"}, 3},
		{clients.Request{Method: http.MethodPut, Path: "/x"}, 3},
	}
	for _, tc := range cases {
		before := calls.Load()
		err := client.Do(context.Background(), tc.request, nil)
		if asServiceCallError(t, err).StatusCode != 503 || calls.Load()-before != tc.attempts {
			t.Fatalf("%s %v: %d attempts, want %d", tc.request.Method, tc.request.Header, calls.Load()-before, tc.attempts)
		}
	}
}

func TestServiceClientRetriesTimeoutsOfIdempotentRequests(t *testing.T) {
	server, calls := countingServer(t, func(_ http.ResponseWriter, r *http.Request) {
		_, _ = io.Copy(io.Discard, r.Body)
		select {
		case <-r.Context().Done():
		case <-time.After(5 * time.Second):
		}
	})
	client := newServiceClient(t, server, clients.Config{Timeout: 20 * time.Millisecond})
	var netErr net.Error
	if err := client.Get(context.Background(), "/slow", nil); !errors.As(err, &netErr) || !netErr.Timeout() || calls.Load() != 3 {
		t.Fatalf("a timed-out GET is retried: %v calls=%d", err, calls.Load())
	}
	if err := client.Post(context.Background(), "/slow", map[string]int{"n": 1}, nil); err == nil || calls.Load() != 4 {
		t.Fatalf("a timed-out POST runs once: %v calls=%d", err, calls.Load())
	}
}

type countingTransport struct {
	next  http.RoundTripper
	calls atomic.Int32
}

func (c *countingTransport) RoundTrip(r *http.Request) (*http.Response, error) {
	c.calls.Add(1)
	return c.next.RoundTrip(r)
}

func TestServiceClientDoesNotRetryBrokenConnections(t *testing.T) {
	untrusted := httptest.NewTLSServer(http.NotFoundHandler())
	defer untrusted.Close()
	transport := &countingTransport{next: &http.Transport{}}
	client, err := clients.New(clients.Config{BaseURL: untrusted.URL, ServiceName: "knowledge", Retry: fastRetry(2),
		HTTPClient: &http.Client{Transport: transport}})
	if err != nil {
		t.Fatal(err)
	}
	var verification *tls.CertificateVerificationError
	if err := client.Get(context.Background(), "/x", nil); !errors.As(err, &verification) || transport.calls.Load() != 1 {
		t.Fatalf("a TLS verification failure is final: %v attempts=%d", err, transport.calls.Load())
	}

	hangUp, calls := countingServer(t, func(w http.ResponseWriter, _ *http.Request) {
		if conn, _, err := http.NewResponseController(w).Hijack(); err == nil {
			_ = conn.Close()
		}
	})
	if err := newServiceClient(t, hangUp, clients.Config{}).Get(context.Background(), "/x", nil); err == nil || calls.Load() != 1 {
		t.Fatalf("a connection lost after the request was sent is final: %v calls=%d", err, calls.Load())
	}
}

func TestServiceClientHonoursRetryAfter(t *testing.T) {
	server, calls := countingServer(t, func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("Retry-After", r.URL.Query().Get("after"))
		w.WriteHeader(http.StatusTooManyRequests)
	})
	capped := &clients.RetryPolicy{MaxRetries: 1, BaseDelay: time.Millisecond, MaxDelay: 100 * time.Millisecond}
	client := newServiceClient(t, server, clients.Config{Retry: capped})
	inAnHour := time.Now().Add(time.Hour).UTC().Format(http.TimeFormat)
	for after, want := range map[string]time.Duration{"3600": time.Hour, inAnHour: time.Hour, "soon": 0, "-5": 0} {
		started := time.Now()
		err := client.Do(context.Background(), clients.Request{Path: "/x", Query: url.Values{"after": {after}}}, nil)
		elapsed := time.Since(started)
		var status *clients.StatusError
		if !errors.As(err, &status) || status.StatusCode != 429 || status.RetryAfter > want || status.RetryAfter < want-time.Minute {
			t.Fatalf("Retry-After %q parses to %v: %v", after, want, err)
		}
		if waited := elapsed >= 90*time.Millisecond; waited != (want > 0) || elapsed > 5*time.Second {
			t.Fatalf("Retry-After %q waits up to MaxDelay: %v", after, elapsed)
		}
	}
	if calls.Load() != 8 {
		t.Fatalf("a 429 GET is retried: %d calls", calls.Load())
	}
	if err := client.Post(context.Background(), "/x?after=1", nil, nil); asServiceCallError(t, err).StatusCode != 429 || calls.Load() != 9 {
		t.Fatalf("a 429 POST is final: %v calls=%d", err, calls.Load())
	}
}

