type staticToken struct {
	token string
	err   error
}

func (s staticToken) Token(context.Context) (string, error) { return s.token, s.err }

func TestServiceClientBearerTokens(t *testing.T) {
	server, calls := countingServer(t, func(w http.ResponseWriter, r *http.Request) {
		if r.Header.Get("Authorization") != "Bearer static" {
			w.WriteHeader(http.StatusForbidden)
			return
		}
		w.WriteHeader(http.StatusUnauthorized)
	})
	err := newServiceClient(t, server, clients.Config{Auth: staticToken{token: "static"}}).Get(context.Background(), "/x", nil)
	if asServiceCallError(t, err).StatusCode != 401 || calls.Load() != 1 {
		t.Fatalf("a 401 is final for a source that cannot refresh: %v calls=%d", err, calls.Load())
	}
	failure := errors.New("vault sealed")
	err = newServiceClient(t, server, clients.Config{Auth: staticToken{err: failure}}).Get(context.Background(), "/x", nil)
	if !errors.Is(err, failure) || calls.Load() != 1 {
		t.Fatalf("token errors fail the call before sending: %v", err)
	}
}

func TestServiceClientClientCredentials(t *testing.T) {
	var fetches atomic.Int32
	issuer, _ := countingServer(t, func(w http.ResponseWriter, r *http.Request) {
		if err := r.ParseForm(); err != nil || r.URL.Path != "/realms/app/protocol/openid-connect/token" ||
			r.PostForm.Get("grant_type") != "client_credentials" || r.PostForm.Get("client_id") != "svc-orders" ||
			r.PostForm.Get("client_secret") != "s3cret" || r.PostForm.Get("scope") != "read write" {
			w.WriteHeader(http.StatusBadRequest)
			return
		}
		n := fetches.Add(1)
		_ = json.NewEncoder(w).Encode(map[string]any{"access_token": "tok-" + strconv.Itoa(int(n)), "expires_in": 300})
	})
	var revoked atomic.Bool
	downstream, calls := countingServer(t, func(w http.ResponseWriter, r *http.Request) {
		if r.Header.Get("Authorization") == "Bearer tok-1" && !revoked.Swap(true) {
			w.WriteHeader(http.StatusUnauthorized)
			return
		}
		w.WriteHeader(http.StatusNoContent)
	})
	credentials := clients.KeycloakClientCredentials(issuer.URL+"/", "app", "svc-orders", "s3cret")
	credentials.Scopes = []string{"read", "write"}
	client := newServiceClient(t, downstream, clients.Config{Auth: credentials})
	if err := client.Get(context.Background(), "/a", nil); err != nil {
		t.Fatalf("a 401 refreshes the token once: %v", err)
	}
	if err := client.Get(context.Background(), "/b", nil); err != nil || fetches.Load() != 2 || calls.Load() != 3 {
		t.Fatalf("the refreshed token is cached: %v fetches=%d calls=%d", err, fetches.Load(), calls.Load())
	}
}

func TestClientCredentialsTokenEndpointFailures(t *testing.T) {
	ctx := context.Background()
	responses := map[string]http.HandlerFunc{
		"unavailable": statusHandler(http.StatusServiceUnavailable, "maintenance"),
		"invalid":     statusHandler(http.StatusOK, "<html>"),
		"empty":       statusHandler(http.StatusOK, `{"expires_in":60}`),
		"redirect": func(w http.ResponseWriter, r *http.Request) {
			http.Redirect(w, r, "http://127.0.0.1:1/token", http.StatusTemporaryRedirect)
		},
	}
	for name, respond := range responses {
		issuer, _ := countingServer(t, respond)
		_, err := clients.NewClientCredentials(issuer.URL, "id", "secret").Token(ctx)
		if err == nil {
			t.Fatalf("%s: token accepted", name)
		}
		var status *clients.StatusError
		if name == "unavailable" && (!errors.As(err, &status) || status.StatusCode != 503 ||
			!clients.DefaultRetryable(clients.Request{Method: http.MethodGet}, err)) {
			t.Fatalf("token endpoint 5xx is a retryable StatusError: %v", err)
		}
		if name == "redirect" && (!errors.As(err, &status) || status.StatusCode != http.StatusTemporaryRedirect) {
			t.Fatalf("the token request does not follow redirects: %v", err)
		}
	}
	if _, err := clients.NewClientCredentials("://bad", "id", "secret").Token(ctx); err == nil {
		t.Fatal("an invalid token URL fails")
	}
	closed := httptest.NewServer(http.NotFoundHandler())
	closed.Close()
	if _, err := clients.NewClientCredentials(closed.URL, "id", "secret").Token(ctx); err == nil {
		t.Fatal("an unreachable token endpoint fails")
	}

	issuer, fetches := countingServer(t, statusHandler(http.StatusOK, `{"access_token":"short"}`))
	credentials := clients.NewClientCredentials(issuer.URL, "id", "secret")
	credentials.HTTPClient = issuer.Client()
	for range 2 {
		if token, err := credentials.Token(ctx); err != nil || token != "short" {
			t.Fatalf("token %q %v", token, err)
		}
	}
	if fetches.Load() != 1 {
		t.Fatalf("expires_in defaults to 300s: %d fetches", fetches.Load())
	}
	credentials.RefreshMargin = time.Hour
	credentials.Invalidate(ctx)
	for range 2 {
		_, _ = credentials.Token(ctx)
	}
	if fetches.Load() != 3 {
		t.Fatalf("a token inside the refresh margin is refetched: %d fetches", fetches.Load())
	}
}

func TestClientCredentialsShareOneFetch(t *testing.T) {
	release := make(chan struct{})
	releaseOnce := sync.OnceFunc(func() { close(release) })
	time.AfterFunc(5*time.Second, releaseOnce)
	issuer, fetches := countingServer(t, func(w http.ResponseWriter, _ *http.Request) {
		<-release
		_ = json.NewEncoder(w).Encode(map[string]any{"access_token": "shared", "expires_in": 300})
	})
	t.Cleanup(releaseOnce)
	credentials := clients.NewClientCredentials(issuer.URL, "id", "secret")
	tokens := make(chan string, 3)
	for range 3 {
		go func() {
			token, _ := credentials.Token(context.Background())
			tokens <- token
		}()
	}
	for fetches.Load() == 0 {
		time.Sleep(time.Millisecond)
	}
	impatient, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
	defer cancel()
	if _, err := credentials.Token(impatient); !errors.Is(err, context.DeadlineExceeded) {
		t.Fatalf("a waiting caller gives up with its context: %v", err)
	}
	releaseOnce()
	for range 3 {
		if token := <-tokens; token != "shared" {
			t.Fatalf("token %q", token)
		}
	}
	if fetches.Load() != 1 {
		t.Fatalf("concurrent callers share one fetch: %d", fetches.Load())
	}
}

func TestClientCredentialsShareFailures(t *testing.T) {
	release := make(chan struct{})
	releaseOnce := sync.OnceFunc(func() { close(release) })
	time.AfterFunc(5*time.Second, releaseOnce)
	issuer, fetches := countingServer(t, func(w http.ResponseWriter, _ *http.Request) {
		<-release
		w.WriteHeader(http.StatusServiceUnavailable)
	})
	t.Cleanup(releaseOnce)
	credentials := clients.NewClientCredentials(issuer.URL, "id", "secret")
	failures := make(chan error, 3)
	for range 3 {
		go func() {
			_, err := credentials.Token(context.Background())
			failures <- err
		}()
	}
	for fetches.Load() == 0 {
		time.Sleep(time.Millisecond)
	}
	time.Sleep(50 * time.Millisecond)
	releaseOnce()
	for range 3 {
		var status *clients.StatusError
		if err := <-failures; !errors.As(err, &status) || status.StatusCode != 503 {
			t.Fatalf("waiters share the failure: %v", err)
		}
	}
	if fetches.Load() != 1 {
		t.Fatalf("a failed fetch is not repeated by its waiters: %d", fetches.Load())
	}
}

func TestClientCredentialsWaitersOutliveACancelledFetch(t *testing.T) {
	var requests atomic.Int32
	issuer, fetches := countingServer(t, func(w http.ResponseWriter, r *http.Request) {
		_, _ = io.Copy(io.Discard, r.Body)
		if requests.Add(1) == 1 {
			select {
			case <-r.Context().Done():
				return
			case <-time.After(5 * time.Second):
			}
		}
		_ = json.NewEncoder(w).Encode(map[string]any{"access_token": "second", "expires_in": 300})
	})
	credentials := clients.NewClientCredentials(issuer.URL, "id", "secret")
	leader, cancel := context.WithCancel(context.Background())
	led := make(chan error, 1)
	go func() {
		_, err := credentials.Token(leader)
		led <- err
	}()
	for fetches.Load() == 0 {
		time.Sleep(time.Millisecond)
	}
	waited := make(chan string, 1)
	go func() {
		token, _ := credentials.Token(context.Background())
		waited <- token
	}()
	time.Sleep(20 * time.Millisecond)
	cancel()
	if err := <-led; !errors.Is(err, context.Canceled) {
		t.Fatalf("the cancelled caller fails: %v", err)
	}
	if token := <-waited; token != "second" || fetches.Load() != 2 {
		t.Fatalf("a waiter fetches again when the caller it waited on gave up: %q fetches=%d", token, fetches.Load())
	}
}
