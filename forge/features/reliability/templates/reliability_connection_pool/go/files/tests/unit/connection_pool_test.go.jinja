package unit_test

import (
	"context"
	"testing"
	"time"

	"github.com/jackc/pgx/v5/pgxpool"

	"{{ project_name }}/internal/db"
)

func poolTuningEnv(values map[string]string) func(string) string {
	return func(name string) string { return values[name] }
}

func parsedPoolConfig(t *testing.T, url string) *pgxpool.Config {
	t.Helper()
	cfg, err := pgxpool.ParseConfig(url)
	if err != nil {
		t.Fatal(err)
	}
	return cfg
}

func TestPoolTuningAppliesDefaults(t *testing.T) {
	cfg := parsedPoolConfig(t, "postgresql://postgres@127.0.0.1:1/app")
	if err := db.TunePool(cfg, poolTuningEnv(nil)); err != nil {
		t.Fatal(err)
	}
	if cfg.MaxConns != db.DefaultPoolMaxConns || cfg.MinConns != db.DefaultPoolMinConns ||
		cfg.MaxConnIdleTime != db.DefaultPoolIdleTimeout || cfg.ConnConfig.ConnectTimeout != db.DefaultPoolConnectTimeout {
		t.Fatalf("defaults: max=%d min=%d idle=%v connect=%v",
			cfg.MaxConns, cfg.MinConns, cfg.MaxConnIdleTime, cfg.ConnConfig.ConnectTimeout)
	}
	explicit := parsedPoolConfig(t, "postgresql://postgres@127.0.0.1:1/app?connect_timeout=3")
	if err := db.TunePool(explicit, poolTuningEnv(nil)); err != nil {
		t.Fatal(err)
	}
	if explicit.ConnConfig.ConnectTimeout != 3*time.Second {
		t.Fatalf("connection-string connect_timeout is kept: %v", explicit.ConnConfig.ConnectTimeout)
	}
}

func TestPoolTuningReadsEnv(t *testing.T) {
	cfg := parsedPoolConfig(t, "postgresql://postgres@127.0.0.1:1/app?connect_timeout=3")
	err := db.TunePool(cfg, poolTuningEnv(map[string]string{
		"PGX_MAX_CONNECTIONS":      "7",
		"PGX_MIN_CONNECTIONS":      "0",
		"PGX_CONNECT_TIMEOUT_SECS": "4",
		"PGX_IDLE_TIMEOUT_SECS":    "60",
	}))
	if err != nil {
		t.Fatal(err)
	}
	if cfg.MaxConns != 7 || cfg.MinConns != 0 || cfg.ConnConfig.ConnectTimeout != 4*time.Second || cfg.MaxConnIdleTime != time.Minute {
		t.Fatalf("env: max=%d min=%d idle=%v connect=%v",
			cfg.MaxConns, cfg.MinConns, cfg.MaxConnIdleTime, cfg.ConnConfig.ConnectTimeout)
	}
}

func TestPoolTuningRejectsInvalidSettings(t *testing.T) {
	for _, env := range []map[string]string{
		{"PGX_MAX_CONNECTIONS": "0"},
		{"PGX_MAX_CONNECTIONS": "many"},
		{"PGX_MAX_CONNECTIONS": "99999999999"},
		{"PGX_MIN_CONNECTIONS": "-1"},
		{"PGX_MIN_CONNECTIONS": "30"},
		{"PGX_IDLE_TIMEOUT_SECS": "0"},
		{"PGX_CONNECT_TIMEOUT_SECS": "soon"},
	} {
		cfg := parsedPoolConfig(t, "postgresql://postgres@127.0.0.1:1/app")
		if err := db.TunePool(cfg, poolTuningEnv(env)); err == nil {
			t.Fatalf("%v must be rejected", env)
		}
	}
}

func TestPoolTuningIsAppliedByNewPool(t *testing.T) {
	t.Setenv("PGX_MAX_CONNECTIONS", "6")
	pool, err := db.NewPool(context.Background(), "postgresql://postgres@127.0.0.1:1/app?connect_timeout=1", 2, time.Second)
	if err != nil {
		t.Fatal(err)
	}
	defer pool.Close()
	if pool.Config().MaxConns != 6 || pool.Config().MinConns != db.DefaultPoolMinConns {
		t.Fatalf("NewPool tunes the pool: max=%d min=%d", pool.Config().MaxConns, pool.Config().MinConns)
	}
	t.Setenv("PGX_MAX_CONNECTIONS", "none")
	if _, err := db.NewPool(context.Background(), "postgresql://postgres@127.0.0.1:1/app", 2, time.Second); err == nil {
		t.Fatal("invalid pool settings fail NewPool")
	}
}
