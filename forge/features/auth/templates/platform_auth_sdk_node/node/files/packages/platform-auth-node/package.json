{
  "name": "@forge/platform-auth-node",
  "version": "0.1.0",
  "description": "Identity, RBAC, and S2S auth primitives for Fastify services \u2014 Node port of platform-auth (Python). Verifies Gatekeeper-issued ES256 JWTs, multi-issuer JWKS cache with stale-serve, scope-based authz with wildcard, RFC 8693 token-exchange.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./testing": {
      "import": "./dist/testing.js",
      "types": "./dist/testing.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --write src/ test/",
    "format": "biome format --write src/ test/"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "lru-cache": "^11.5.3",
    "fastify-plugin": "^6.0.0"
  },
  "overrides": {
    "vitest": "5.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "fastify": "^5.12.7",
    "typescript": "^6.0.3",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "fastify": "^5.12.7"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ]
}
