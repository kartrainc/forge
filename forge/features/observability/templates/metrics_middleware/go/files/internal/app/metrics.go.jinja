package app

import (
	"context"
	"log/slog"
	"net/http"
	"time"

	"{{ project_name }}/internal/config"
	"{{ project_name }}/internal/otel"
)

// StartMetrics installs the OTLP metric exporter and Go runtime metrics (a
// no-op without OTEL_EXPORTER_OTLP_ENDPOINT) and returns the flush to defer
// until exit.
func StartMetrics(ctx context.Context, cfg *config.Config) func() {
	shutdown, err := otel.ConfigureMetrics(ctx, cfg.App.Name)
	if err != nil {
		slog.Warn("opentelemetry metrics disabled", "error", err)
	}
	return func() {
		flush, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		if err := shutdown(flush); err != nil {
			slog.Warn("opentelemetry metrics flush failed", "error", err)
		}
	}
}

func otelMetrics(next http.Handler) http.Handler { return otel.MetricsMiddleware(next) }
