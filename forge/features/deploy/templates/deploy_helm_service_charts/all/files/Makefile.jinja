# Deployment helpers for {{ topology.project_slug }} (generated by forge).
# One Helm chart per component under deploy/helm/<chart>/ (deploy.helm_layout=per_service), each installed as its own
# release named after the chart, in dependency order: the datastores, Keycloak, the gatekeeper, then the services.
# Raw manifests in deploy/k8s/ are derived from the charts (never hand-edit deploy/k8s/rendered.yaml).

NAMESPACE ?= default
INFRA := {{ (topology.helm_postgres + topology.helm_redis + topology.helm_keycloak + topology.helm_gatekeeper) | map(attribute='name') | join(' ') }}
SERVICES := {{ (topology.backends | map(attribute='name') | list + topology.frontends | map(attribute='name') | list) | join(' ') }}
CHARTS := $(INFRA) $(SERVICES)
REVERSED := $(SERVICES) {{ (topology.helm_postgres + topology.helm_redis + topology.helm_keycloak + topology.helm_gatekeeper) | map(attribute='name') | reverse | join(' ') }}
# A chart's environment values, used when present: deploy/helm/<chart>/values-$(ENV).yaml
ENV ?= prod

.PHONY: help compose-up compose-down helm-lint helm-template k8s-manifests helm-install helm-uninstall

help:
	@grep -E "^[a-zA-Z_-]+:.*?#" $(MAKEFILE_LIST) | awk 'BEGIN{FS=":.*?# "}{printf "  %-16s %s\n", $$1, $$2}'

compose-up: ## Boot the full local stack (docker compose)
	docker compose up --build -d

compose-down: ## Stop the local stack
	docker compose down

helm-lint: ## Lint every chart
	@for c in $(CHARTS); do helm lint deploy/helm/$$c || exit 1; done

helm-template: ## Render every chart to stdout
	@for c in $(CHARTS); do helm template $$c deploy/helm/$$c || exit 1; done

k8s-manifests: ## Render raw manifests to deploy/k8s/rendered.yaml (derived from the charts)
	@mkdir -p deploy/k8s
	@for c in $(CHARTS); do helm template $$c deploy/helm/$$c || exit 1; done > deploy/k8s/rendered.yaml
	@echo "Wrote deploy/k8s/rendered.yaml"

helm-install: ## Install/upgrade every chart in dependency order (each with its values-$(ENV).yaml if present)
	@for c in $(CHARTS); do \
	  v=deploy/helm/$$c/values-$(ENV).yaml; \
	  helm upgrade --install $$c deploy/helm/$$c --namespace $(NAMESPACE) --create-namespace $$( [ -f $$v ] && echo "-f $$v" ) || exit 1; \
	done

helm-uninstall: ## Remove every release
	@for c in $(REVERSED); do helm uninstall $$c --namespace $(NAMESPACE) || true; done
