package e2e_test

import (
	"context"
	"crypto/rand"
	"encoding/hex"
	"net/url"
	"testing"

	"github.com/jackc/pgx/v5"
	"github.com/jackc/pgx/v5/pgxpool"

	"{{ project_name }}/tests/testutil"
)

func init() { serverEnv = tenantRoleEnv }

// tenantRoleEnv points a started binary at a fresh role that is NOSUPERUSER
// NOBYPASSRLS and owns no tables, as database.rls_app_role provisions, so the
// startup guard (database.rls_startup_guard) lets it serve.
func tenantRoleEnv(t *testing.T) []string {
	t.Helper()
	base := testutil.DatabaseURL(t)
	ctx := context.Background()
	admin, err := pgxpool.New(ctx, base)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(admin.Close)
	role, password := "forge_e2e_"+randomHex(t), randomHex(t)
	ident := pgx.Identifier{role}.Sanitize()
	if _, err := admin.Exec(ctx, "CREATE ROLE "+ident+" LOGIN PASSWORD '"+password+
		"' NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE"); err != nil {
		t.Fatalf("create a role RLS applies to: %v", err)
	}
	t.Cleanup(func() {
		if _, err := admin.Exec(context.Background(), "DROP ROLE "+ident); err != nil {
			t.Errorf("drop role: %v", err)
		}
	})
	parsed, err := url.Parse(base)
	if err != nil {
		t.Fatal(err)
	}
	parsed.User = url.UserPassword(role, password)
	return []string{"DATABASE_URL=" + parsed.String()}
}

func randomHex(t *testing.T) string {
	t.Helper()
	buf := make([]byte, 8)
	if _, err := rand.Read(buf); err != nil {
		t.Fatal(err)
	}
	return hex.EncodeToString(buf)
}
