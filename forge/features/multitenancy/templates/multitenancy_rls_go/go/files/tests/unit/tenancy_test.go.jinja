type recordingTx struct {
	pgx.Tx
	execErr    error
	statements []string
	arguments  [][]any
	committed  bool
	rolledBack bool
}

func (tx *recordingTx) Exec(_ context.Context, sql string, args ...any) (pgconn.CommandTag, error) {
	tx.statements = append(tx.statements, sql)
	tx.arguments = append(tx.arguments, args)
	return pgconn.CommandTag{}, tx.execErr
}

func (tx *recordingTx) Commit(context.Context) error {
	tx.committed = true
	return nil
}

func (tx *recordingTx) Rollback(context.Context) error {
	if tx.committed {
		return pgx.ErrTxClosed
	}
	tx.rolledBack = true
	return nil
}

type txStarter struct {
	tx  *recordingTx
	err error
}

func (s txStarter) Begin(context.Context) (pgx.Tx, error) {
	if s.err != nil {
		return nil, s.err
	}
	return s.tx, nil
}

func TestInTxBindsTheTenantForOneTransaction(t *testing.T) {
	ctx := context.Background()
	tx := &recordingTx{}
	called := false
	err := tenancy.InTx(ctx, txStarter{tx: tx}, "app.current_tenant", "t-1", func(got pgx.Tx) error {
		called = got == pgx.Tx(tx)
		return nil
	})
	if err != nil || !called || !tx.committed {
		t.Fatalf("commit: %v called=%v committed=%v", err, called, tx.committed)
	}
	if len(tx.statements) != 1 || tx.statements[0] != "SELECT set_config($1, $2, true)" ||
		tx.arguments[0][0] != "app.current_tenant" || tx.arguments[0][1] != "t-1" {
		t.Fatalf("binding: %v %v", tx.statements, tx.arguments)
	}

	unbound := &recordingTx{}
	if err := tenancy.InTx(ctx, txStarter{tx: unbound}, "app.current_tenant", "", func(pgx.Tx) error { return nil }); err != nil || len(unbound.statements) != 0 {
		t.Fatalf("an empty tenant binds nothing: %v %v", err, unbound.statements)
	}

	boom := errors.New("boom")
	failing := &recordingTx{execErr: boom}
	ran := false
	if err := tenancy.InTx(ctx, txStarter{tx: failing}, "app.current_tenant", "t-1", func(pgx.Tx) error { ran = true; return nil }); !errors.Is(err, boom) || ran || !failing.rolledBack {
		t.Fatalf("a failed binding rolls back before fn: %v ran=%v", err, ran)
	}
	rejected := &recordingTx{}
	if err := tenancy.InTx(ctx, txStarter{tx: rejected}, "app.current_tenant", "t-1", func(pgx.Tx) error { return boom }); !errors.Is(err, boom) || rejected.committed || !rejected.rolledBack {
		t.Fatalf("fn errors roll back: %v", err)
	}
	if err := tenancy.InTx(ctx, txStarter{err: boom}, "app.current_tenant", "t-1", func(pgx.Tx) error { return nil }); !errors.Is(err, boom) {
		t.Fatalf("begin errors surface: %v", err)
	}
}

func TestScopeBindsTheCallersTenant(t *testing.T) {
	ctx := context.Background()
	settings := tenancy.DefaultSettings()
	settings.GUC = "app.tenant"
	tx := &recordingTx{}
	scope := tenancy.Scope(txStarter{tx: tx}, tenancy.NewResolver(settings, nil))
	account := identity.New(uuid.New(), "user")
	var received repositories.DBTX
	if err := scope(ctx, account, func(q repositories.DBTX) error { received = q; return nil }); err != nil {
		t.Fatal(err)
	}
	if received != repositories.DBTX(tx) || tx.arguments[0][0] != "app.tenant" || tx.arguments[0][1] != account.TenantID.String() {
		t.Fatalf("scope: %v %v", received, tx.arguments)
	}
	failing := repositories.NewPgItemRepository(nil).WithScope(tenancy.Scope(txStarter{err: errors.New("down")}, tenancy.NewResolver(settings, nil)))
	if err := failing.Delete(ctx, account, uuid.New()); err == nil {
		t.Fatal("a scope that cannot begin fails the call")
	}
}

