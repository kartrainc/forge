func TestInitTenancyValidatesTheEnvironment(t *testing.T) {
	t.Cleanup(func() { _ = app.InitTenancy() })
	t.Setenv("TENANT_RESOLUTION", "sideways")
	if err := app.InitTenancy(); err == nil || !strings.Contains(err.Error(), "TENANT_RESOLUTION") {
		t.Fatalf("invalid strategy: %v", err)
	}
	t.Setenv("TENANT_RESOLUTION", "")
	t.Setenv("TENANT_RLS_GUC", "app.tenant")
	if err := app.InitTenancy(); err == nil || !strings.Contains(err.Error(), "TENANT_RLS_GUC") {
		t.Fatalf("a GUC the policies do not read: %v", err)
	}
	t.Setenv("TENANT_RLS_GUC", "")
	t.Setenv("TENANT_RESOLUTION", "header")
	t.Setenv("TENANT_HEADER_NAME", "X-Org")
	if err := app.InitTenancy(); err != nil {
		t.Fatal(err)
	}
	pool, err := db.NewPool(context.Background(), unreachable, 1, time.Second)
	if err != nil {
		t.Fatal(err)
	}
	defer pool.Close()
	cfg := config.Defaults()
	handler := app.New(&cfg, pool)
	if status, _ := testutil.Do(t, handler, http.MethodGet, "/api/v1/health/live", nil); status != http.StatusOK {
		t.Fatalf("live: %d", status)
	}
	status, body := testutil.Do(t, handler, http.MethodGet, itemsPath, nil)
	if status != http.StatusServiceUnavailable && status != http.StatusInternalServerError {
		t.Fatalf("items without a database: %d %v", status, body)
	}
}
