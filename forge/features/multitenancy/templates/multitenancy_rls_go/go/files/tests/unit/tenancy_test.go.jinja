func TestTenantRLSMiddlewareRefusesAnotherTenantThanTheTokens(t *testing.T) {
	settings := tenancy.DefaultSettings()
	settings.Resolution = tenancy.ResolutionHeader
	account := identity.New(uuid.New(), "account")
	reached := false
	tenantRLS := middleware.TenantRLS(tenancy.NewResolver(settings, tenancy.VerifiedClaims))(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		reached = true
		w.WriteHeader(http.StatusNoContent)
	}))
	handler := middleware.Correlation(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		ctx := platformauth.WithIdentity(identity.WithContext(r.Context(), account),
			platformauth.IdentityContext{TenantID: account.TenantID, Subject: account.Subject})
		tenantRLS.ServeHTTP(w, r.WithContext(ctx))
	}))
	request := httptest.NewRequest(http.MethodGet, "/", nil)
	request.Header.Set(settings.HeaderName, uuid.NewString())
	recorder := httptest.NewRecorder()
	handler.ServeHTTP(recorder, request)
	var envelope testutil.Envelope
	if err := json.Unmarshal(recorder.Body.Bytes(), &envelope); err != nil || recorder.Code != http.StatusForbidden ||
		envelope.Error.Code != "PERMISSION_DENIED" || envelope.Error.Message != tenancy.ErrTenantMismatch.Error() || reached {
		t.Fatalf("another tenant than the token's: %d %s", recorder.Code, recorder.Body.String())
	}
}
