const rlsMigrationVersion = 99

// rlsSchema returns a migrated test schema.
func rlsSchema(t *testing.T) testutil.TestSchema {
	t.Helper()
	schema := testutil.NewSchema(t)
	if err := migrations.Up(context.Background(), schema.URL); err != nil {
		t.Fatal(err)
	}
	return schema
}

// rlsPool returns a single-connection pool, so every transaction reuses one
// connection, logged in as a role RLS applies to: the DATABASE_URL role when it
// is neither superuser nor BYPASSRLS (FORCE ROW LEVEL SECURITY binds the table
// owner), else a fresh non-owner role.
func rlsPool(t *testing.T, schema testutil.TestSchema) *pgxpool.Pool {
	t.Helper()
	ctx := context.Background()
	var bypasses, canCreate bool
	if err := schema.Admin.QueryRow(ctx,
		"SELECT rolsuper OR rolbypassrls, rolsuper OR rolcreaterole FROM pg_roles WHERE rolname = current_user").Scan(&bypasses, &canCreate); err != nil {
		t.Fatal(err)
	}
	probeURL := schema.URL
	if bypasses {
		if !canCreate {
			t.Skip("the DATABASE_URL role bypasses RLS and cannot create a role that does not")
		}
		probeURL = probeRole(t, schema)
	}
	pool, err := db.NewPool(ctx, probeURL, 1, 5*time.Second)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(pool.Close)
	if err := pool.QueryRow(ctx, "SELECT rolsuper OR rolbypassrls FROM pg_roles WHERE rolname = current_user").Scan(&bypasses); err != nil || bypasses {
		t.Fatalf("the probe role must not bypass RLS: %v %v", bypasses, err)
	}
	return pool
}

// probeRole creates a login role that neither owns the tables nor bypasses
// RLS, grants it the items table and returns schema.URL logged in as it. The
// role is dropped when the test ends.
func probeRole(t *testing.T, schema testutil.TestSchema) string {
	t.Helper()
	ctx := context.Background()
	role, password := "forge_rls_"+randomHex(t), randomHex(t)
	ident := pgx.Identifier{role}.Sanitize()
	statements := []string{
		"CREATE ROLE " + ident + " LOGIN PASSWORD '" + password + "' NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE",
		"GRANT USAGE ON SCHEMA " + schema.Name + " TO " + ident,
		"GRANT SELECT, INSERT, UPDATE, DELETE ON " + schema.Name + ".items TO " + ident,
	}
	for _, statement := range statements {
		if _, err := schema.Admin.Exec(ctx, statement); err != nil {
			t.Fatal(err)
		}
	}
	t.Cleanup(func() {
		ctx := context.Background()
		// A CREATEROLE admin may not DROP OWNED BY the role, so revoke its grants first.
		_, _ = schema.Admin.Exec(ctx, "REVOKE ALL ON "+schema.Name+".items FROM "+ident)
		_, _ = schema.Admin.Exec(ctx, "REVOKE ALL ON SCHEMA "+schema.Name+" FROM "+ident)
		_, _ = schema.Admin.Exec(ctx, "DROP OWNED BY "+ident)
		if _, err := schema.Admin.Exec(ctx, "DROP ROLE "+ident); err != nil {
			t.Errorf("drop role: %v", err)
		}
	})
	parsed, err := url.Parse(schema.URL)
	if err != nil {
		t.Fatal(err)
	}
	parsed.User = url.UserPassword(role, password)
	return parsed.String()
}

// tenantHandler serves the application through pool with the tenant resolved
// by resolution, as TENANT_RESOLUTION configures it.
func tenantHandler(t *testing.T, cfg *config.Config, pool *pgxpool.Pool, resolution string) http.Handler {
	t.Helper()
	t.Cleanup(func() { _ = app.InitTenancy() })
	t.Setenv("TENANT_RESOLUTION", resolution)
	t.Setenv("TENANT_HEADER_NAME", tenancy.DefaultHeaderName)
	if err := app.InitTenancy(); err != nil {
		t.Fatal(err)
	}
	return app.New(cfg, pool)
}

// caller names a request's tenant with a header, a host or a bearer token.
type caller struct{ tenant, host, token string }

func (c caller) call(t *testing.T, handler http.Handler, method, path string, payload any) (int, map[string]any) {
	t.Helper()
	var body bytes.Buffer
	if payload != nil {
		if err := json.NewEncoder(&body).Encode(payload); err != nil {
			t.Fatal(err)
		}
	}
	request := httptest.NewRequest(method, path, &body)
	request.Header.Set("Content-Type", "application/json")
	if c.tenant != "" {
		request.Header.Set(tenancy.DefaultHeaderName, c.tenant)
	}
	if c.host != "" {
		request.Host = c.host
	}
	if c.token != "" {
		request.Header.Set("Authorization", "Bearer "+c.token)
	}
	recorder := httptest.NewRecorder()
	handler.ServeHTTP(recorder, request)
	decoded := map[string]any{}
	_ = json.Unmarshal(recorder.Body.Bytes(), &decoded)
	return recorder.Code, decoded
}

func randomHex(t *testing.T) string {
	t.Helper()
	buf := make([]byte, 12)
	if _, err := rand.Read(buf); err != nil {
		t.Fatal(err)
	}
	return hex.EncodeToString(buf)
}

// rlsState reports whether items has RLS enabled and forced, and how many
// tenant_isolation_items policies it carries.
func rlsState(t *testing.T, schema testutil.TestSchema) (enabled, forced bool, policies int) {
	t.Helper()
	err := schema.Admin.QueryRow(context.Background(), `
		SELECT c.relrowsecurity, c.relforcerowsecurity,
		       (SELECT count(*) FROM pg_policy p WHERE p.polrelid = c.oid AND p.polname = 'tenant_isolation_items')
		FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace
		WHERE n.nspname = $1 AND c.relname = 'items'`, schema.Name).Scan(&enabled, &forced, &policies)
	if err != nil {
		t.Fatal(err)
	}
	return enabled, forced, policies
}

func TestRLSMigrationIsIdempotentAndReversible(t *testing.T) {
	ctx := context.Background()
	schema := rlsSchema(t)
	if err := migrations.Up(ctx, schema.URL); err != nil {
		t.Fatal(err)
	}
	if enabled, forced, policies := rlsState(t, schema); !enabled || !forced || policies != 1 {
		t.Fatalf("after up: enabled=%v forced=%v policies=%d", enabled, forced, policies)
	}

	source, err := os.ReadFile(filepath.Join(testutil.ServiceRoot(), "migrations", "00099_enable_rls.sql"))
	if err != nil {
		t.Fatal(err)
	}
	up, _, found := strings.Cut(string(source), "-- +goose Down")
	if !found {
		t.Fatal("the migration has a Down section")
	}
	pool, err := pgxpool.New(ctx, schema.URL)
	if err != nil {
		t.Fatal(err)
	}
	defer pool.Close()
	if _, err := pool.Exec(ctx, up); err != nil {
		t.Fatalf("re-running the Up section: %v", err)
	}
	if enabled, forced, policies := rlsState(t, schema); !enabled || !forced || policies != 1 {
		t.Fatalf("after a re-run: enabled=%v forced=%v policies=%d", enabled, forced, policies)
	}

	provider, err := migrations.Open(schema.URL, migrations.Embedded())
	if err != nil {
		t.Fatal(err)
	}
	defer provider.Close()
	if _, err := provider.ApplyVersion(ctx, rlsMigrationVersion, false); err != nil {
		t.Fatal(err)
	}
	if enabled, forced, policies := rlsState(t, schema); enabled || forced || policies != 0 {
		t.Fatalf("after down: enabled=%v forced=%v policies=%d", enabled, forced, policies)
	}
	if _, err := provider.ApplyVersion(ctx, rlsMigrationVersion, true); err != nil {
		t.Fatal(err)
	}
	if enabled, forced, policies := rlsState(t, schema); !enabled || !forced || policies != 1 {
		t.Fatalf("after up again: enabled=%v forced=%v policies=%d", enabled, forced, policies)
	}
}

func TestRLSIsolatesTenantsForTheProbeRole(t *testing.T) {
	ctx := context.Background()
	schema := rlsSchema(t)
	pool := rlsPool(t, schema)
	scope := tenancy.Scope(pool, tenancy.NewResolver(tenancy.DefaultSettings(), nil))
	repo := repositories.NewPgItemRepository(pool).WithScope(scope)
	tenantA := identity.New(uuid.New(), uuid.NewString())
	tenantB := identity.New(uuid.New(), uuid.NewString())

	if _, err := repositories.NewPgItemRepository(pool).Create(ctx, tenantA, models.CreateItem{Name: "unbound"}); err == nil {
		t.Fatal("without a bound tenant the policy rejects the insert")
	}
	created, err := repo.Create(ctx, tenantA, models.CreateItem{Name: "a-secret"})
	if err != nil || created.CustomerID != tenantA.TenantID {
		t.Fatalf("create as tenant A: %+v %v", created, err)
	}

	count := func(ctx context.Context, ident identity.IdentityContext) int64 {
		t.Helper()
		var n int64
		if err := scope(ctx, ident, func(q repositories.DBTX) error {
			return q.QueryRow(ctx, "SELECT count(*) FROM items").Scan(&n)
		}); err != nil {
			t.Fatal(err)
		}
		return n
	}
	if n := count(ctx, tenantA); n != 1 {
		t.Fatalf("tenant A sees its own row: %d", n)
	}
	if n := count(ctx, tenantB); n != 0 {
		t.Fatalf("tenant B must NOT see tenant A's row (RLS leak): %d", n)
	}
	if n := count(ctx, identity.IdentityContext{}); n != 0 {
		t.Fatalf("no tenant fails closed: %d", n)
	}
	if n := count(tenancy.WithTenant(ctx, tenantA.TenantID.String()), identity.IdentityContext{}); n != 1 {
		t.Fatalf("the request's tenant binds without an identity tenant: %d", n)
	}
	if n := count(tenancy.WithTenant(ctx, tenantA.TenantID.String()), tenantB); n != 0 {
		t.Fatalf("the identity's tenant wins over the request's: %d", n)
	}
	var unscoped int64
	if err := pool.QueryRow(ctx, "SELECT count(*) FROM items").Scan(&unscoped); err != nil || unscoped != 0 {
		t.Fatalf("a recycled connection outside a tenant transaction sees nothing: %d %v", unscoped, err)
	}

	for _, statement := range []string{"UPDATE items SET name = 'pwned'", "DELETE FROM items"} {
		var affected int64
		if err := scope(ctx, tenantB, func(q repositories.DBTX) error {
			tag, err := q.Exec(ctx, statement)
			affected = tag.RowsAffected()
			return err
		}); err != nil || affected != 0 {
			t.Fatalf("%s as tenant B: %d rows, %v", statement, affected, err)
		}
	}
	err = scope(ctx, tenantB, func(q repositories.DBTX) error {
		_, err := q.Exec(ctx, "INSERT INTO items (name, customer_id, user_id) VALUES ('forged', $1, $2)",
			tenantA.TenantID, uuid.New())
		return err
	})
	var pgErr *pgconn.PgError
	if !errors.As(err, &pgErr) || pgErr.Code != "42501" {
		t.Fatalf("writing another tenant's row violates the policy: %v", err)
	}

	if found, err := repo.GetByID(ctx, tenantA, created.ID); err != nil || found == nil || found.Name != "a-secret" {
		t.Fatalf("tenant A's row is untouched: %+v %v", found, err)
	}
	if page, err := repo.List(ctx, tenantB, models.ListParams{Limit: 10}); err != nil || page.Total != 0 {
		t.Fatalf("tenant B lists nothing: %+v %v", page, err)
	}
}
