func TestRLSIsolatesTheTenantsRequestsName(t *testing.T) {
	schema := rlsSchema(t)
	pool := rlsPool(t, schema)
	cfg := config.Defaults()
	for _, resolution := range []string{tenancy.ResolutionHeader, tenancy.ResolutionSubdomain} {
		handler := tenantHandler(t, &cfg, pool, resolution)
		as := func(tenant string) caller {
			if resolution == tenancy.ResolutionHeader {
				return caller{tenant: tenant}
			}
			return caller{host: tenant + ".example.com:8443"}
		}
		tenantA, tenantB := as(uuid.NewString()), as(uuid.NewString())

		status, item := tenantA.call(t, handler, http.MethodPost, itemsPath, map[string]any{"name": "a-secret"})
		if status != http.StatusCreated {
			t.Fatalf("%s: tenant A creates: %d %v", resolution, status, item)
		}
		endpoint := itemsPath + "/" + item["id"].(string)
		if status, page := tenantA.call(t, handler, http.MethodGet, itemsPath, nil); status != http.StatusOK || page["total"] != float64(1) {
			t.Fatalf("%s: tenant A lists its item: %d %v", resolution, status, page)
		}
		if status, page := tenantB.call(t, handler, http.MethodGet, itemsPath, nil); status != http.StatusOK || page["total"] != float64(0) {
			t.Fatalf("%s: tenant B must not list tenant A's item (RLS leak): %d %v", resolution, status, page)
		}
		for _, method := range []string{http.MethodGet, http.MethodPatch, http.MethodDelete} {
			if status, _ := tenantB.call(t, handler, method, endpoint, map[string]any{"name": "pwned"}); status != http.StatusNotFound {
				t.Fatalf("%s: %s of tenant A's item as tenant B: %d", resolution, method, status)
			}
		}
		if status, page := (caller{}).call(t, handler, http.MethodGet, itemsPath, nil); status != http.StatusOK || page["total"] != float64(0) {
			t.Fatalf("%s: the dev tenant sees no request tenant's item: %d %v", resolution, status, page)
		}
		if status, body := tenantA.call(t, handler, http.MethodGet, endpoint, nil); status != http.StatusOK || body["name"] != "a-secret" {
			t.Fatalf("%s: tenant A's item is untouched: %d %v", resolution, status, body)
		}
	}
	handler := tenantHandler(t, &cfg, pool, tenancy.ResolutionHeader)
	if status, body := (caller{tenant: "acme"}).call(t, handler, http.MethodGet, itemsPath, nil); status != http.StatusBadRequest || testutil.ErrorCode(body) != "INVALID_INPUT" {
		t.Fatalf("a header tenant that is not a UUID: %d %v", status, body)
	}
}
