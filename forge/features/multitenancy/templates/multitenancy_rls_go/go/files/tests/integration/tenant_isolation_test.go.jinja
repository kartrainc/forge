func TestRLSScopesRequestsToTheTokenTenant(t *testing.T) {
	t.Cleanup(func() {
		cfg := config.Defaults()
		_ = app.InitPlatformAuth(&cfg)
	})
	issuer := authtest.NewIssuer()
	defer issuer.Close()
	t.Setenv("GATEKEEPER_ISSUER", issuer.URL())
	t.Setenv("SERVICE_AUDIENCE", "svc-{{ project_name }}")
	t.Setenv("TENANT_ID_CLAIM", "")
	cfg := config.Defaults()
	cfg.Security.Auth.Enabled = true
	if err := app.InitPlatformAuth(&cfg); err != nil {
		t.Fatal(err)
	}
	schema := rlsSchema(t)
	pool := rlsPool(t, schema)
	handler := app.New(&cfg, pool)
	tenantA, tenantB := uuid.NewString(), uuid.NewString()
	tokenA := issuer.Token(issuer.Options("svc-{{ project_name }}", uuid.NewString(), tenantA))
	tokenB := issuer.Token(issuer.Options("svc-{{ project_name }}", uuid.NewString(), tenantB))
	call := func(method, path, token string, payload any) (int, map[string]any) {
		t.Helper()
		return platformAuthRequest(t, handler, method, path, token, payload)
	}

	status, item := call(http.MethodPost, itemsPath, tokenA, map[string]any{"name": "owned"})
	if status != http.StatusCreated || item["customer_id"] != tenantA {
		t.Fatalf("tenant A creates through the bound transaction: %d %v", status, item)
	}
	if status, page := call(http.MethodGet, itemsPath, tokenA, nil); status != http.StatusOK || page["total"] != float64(1) {
		t.Fatalf("tenant A lists its item: %d %v", status, page)
	}
	if status, page := call(http.MethodGet, itemsPath, tokenB, nil); status != http.StatusOK || page["total"] != float64(0) {
		t.Fatalf("tenant B lists nothing: %d %v", status, page)
	}
	if status, _ := call(http.MethodGet, itemsPath+"/"+item["id"].(string), tokenB, nil); status != http.StatusNotFound {
		t.Fatalf("tenant B cannot read tenant A's item: %d", status)
	}
}

func TestRLSRequestTenantNeverOverridesAVerifiedToken(t *testing.T) {
	t.Cleanup(func() {
		cfg := config.Defaults()
		_ = app.InitPlatformAuth(&cfg)
	})
	issuer := authtest.NewIssuer()
	defer issuer.Close()
	t.Setenv("GATEKEEPER_ISSUER", issuer.URL())
	t.Setenv("SERVICE_AUDIENCE", "svc-{{ project_name }}")
	t.Setenv("TENANT_ID_CLAIM", "")
	cfg := config.Defaults()
	cfg.Security.Auth.Enabled = false
	if err := app.InitPlatformAuth(&cfg); err != nil {
		t.Fatal(err)
	}
	schema := rlsSchema(t)
	handler := tenantHandler(t, &cfg, rlsPool(t, schema), tenancy.ResolutionHeader)
	tenantA, tenantB := uuid.NewString(), uuid.NewString()
	tokenA := issuer.Token(issuer.Options("svc-{{ project_name }}", uuid.NewString(), tenantA))

	status, item := caller{tenant: tenantB, token: tokenA}.call(t, handler, http.MethodPost, itemsPath, map[string]any{"name": "owned"})
	if status != http.StatusCreated || item["customer_id"] != tenantA {
		t.Fatalf("the verified token's tenant wins over the header: %d %v", status, item)
	}
	if status, page := (caller{tenant: "acme", token: tokenA}).call(t, handler, http.MethodGet, itemsPath, nil); status != http.StatusOK || page["total"] != float64(1) {
		t.Fatalf("a verified request ignores the header: %d %v", status, page)
	}
	if status, page := (caller{tenant: tenantB}).call(t, handler, http.MethodGet, itemsPath, nil); status != http.StatusOK || page["total"] != float64(0) {
		t.Fatalf("a dev-mode request acts as the header's tenant: %d %v", status, page)
	}
	if status, body := (caller{tenant: "acme"}).call(t, handler, http.MethodGet, itemsPath, nil); status != http.StatusBadRequest || testutil.ErrorCode(body) != "INVALID_INPUT" {
		t.Fatalf("a dev-mode header that is not a UUID: %d %v", status, body)
	}
}
