const (
	// ResponseCacheStatusHeader reports HIT or MISS under the header name the
	// Python services (fastapi-cache2) use.
	ResponseCacheStatusHeader = "X-FastAPI-Cache"
	// DefaultResponseCacheTTL applies when a route passes a ttl of zero or less.
	DefaultResponseCacheTTL = 60 * time.Second
	// DefaultResponseCacheMemoryBytes bounds the in-memory store.
	DefaultResponseCacheMemoryBytes = 64 << 20
	// maxCachedBodyBytes: larger bodies stream through uncached.
	maxCachedBodyBytes = 1 << 20
	// responseCacheStoreTimeout bounds every store call.
	responseCacheStoreTimeout = 300 * time.Millisecond
	// responseCacheBackoff is how long requests bypass the cache after a
	// store call fails.
	responseCacheBackoff = 5 * time.Second
)

// ResponseCacheStore keeps encoded responses. Implementations must be safe
// for concurrent use.
type ResponseCacheStore interface {
	// Get returns the entry and its remaining ttl; found is false for a
	// missing or expired key.
	Get(ctx context.Context, key string) (entry []byte, ttl time.Duration, found bool, err error)
	Set(ctx context.Context, key string, entry []byte, ttl time.Duration) error
	// Clear deletes every key starting with prefix.
	Clear(ctx context.Context, prefix string) error
}

// ResponseCache caches GET responses per route, per caller and per request
// shape. Keys are "<prefix>:<namespace>:<hash>". A failing store turns
// requests into misses and is bypassed for a few seconds.
type ResponseCache struct {
	store   ResponseCacheStore
	prefix  string
	retryAt atomic.Int64
}

// NewResponseCache builds a cache over store with the key prefix.
func NewResponseCache(store ResponseCacheStore, prefix string) *ResponseCache {
	return &ResponseCache{store: store, prefix: prefix}
}

var defaultResponseCache atomic.Pointer[ResponseCache]

// SetResponseCache installs the process-wide cache used by CacheResponse and
// ClearResponseCache; nil disables caching.
func SetResponseCache(cache *ResponseCache) {
	defaultResponseCache.Store(cache)
}

// CacheResponse caches a route's responses in the process-wide cache for ttl
// under namespace. Routes opt in one by one:
//
//	items.With(middleware.CacheResponse(30*time.Second, "items")).Get("/", list)
//
// A hit replays the stored response without calling the handlers it wraps,
// so authentication and authorization must run before (outside) it. Before
// SetResponseCache runs, requests pass through uncached.
func CacheResponse(ttl time.Duration, namespace string) Middleware {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			if cache := defaultResponseCache.Load(); cache != nil {
				cache.serve(w, r, next, ttl, namespace)
				return
			}
			next.ServeHTTP(w, r)
		})
	}
}

// ClearResponseCache drops namespace from the process-wide cache; an empty
// namespace drops every entry under the prefix.
func ClearResponseCache(ctx context.Context, namespace string) error {
	if cache := defaultResponseCache.Load(); cache != nil {
		return cache.Clear(ctx, namespace)
	}
	return nil
}

// Middleware caches a route's responses in c for ttl under namespace.
func (c *ResponseCache) Middleware(ttl time.Duration, namespace string) Middleware {
	return func(next http.Handler) http.Handler {
		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
			c.serve(w, r, next, ttl, namespace)
		})
	}
}

// Clear drops namespace; an empty namespace drops every entry under the
// prefix. Entries otherwise live until their ttl expires.
func (c *ResponseCache) Clear(ctx context.Context, namespace string) error {
	if namespace == "" {
		return c.store.Clear(ctx, c.prefix+":")
	}
	return c.store.Clear(ctx, c.prefix+":"+namespace+":")
}

type cachedResponse struct {
	Status int         `json:"status"`
	Header http.Header `json:"header"`
	Body   []byte      `json:"body"`
	ETag   string      `json:"etag"`
}

// serve follows fastapi-cache2: only GET is cached; a request Cache-Control
// of no-store bypasses the cache and no-cache skips the lookup but refreshes
// the entry; a hit answers 304 when If-None-Match carries its ETag. A miss is
// written to the client before the entry is stored.
func (c *ResponseCache) serve(w http.ResponseWriter, r *http.Request, next http.Handler, ttl time.Duration, namespace string) {
	if ttl <= 0 {
		ttl = DefaultResponseCacheTTL
	}
	directives := cacheControl(r.Header.Values("Cache-Control"))
	if r.Method != http.MethodGet || directives["no-store"] || time.Now().UnixNano() < c.retryAt.Load() {
		next.ServeHTTP(w, r)
		return
	}
	key, anonymous, ok := c.key(r, namespace)
	if !ok {
		next.ServeHTTP(w, r)
		return
	}
	if !directives["no-cache"] {
		ctx, cancel := context.WithTimeout(r.Context(), responseCacheStoreTimeout)
		raw, remaining, found, err := c.store.Get(ctx, key)
		cancel()
		if err != nil {
			c.storeFailed(r.Context(), "read", err)
			next.ServeHTTP(w, r)
			return
		}
		var entry cachedResponse
		if found && json.Unmarshal(raw, &entry) == nil {
			entry.write(w, r, "HIT", remaining, anonymous)
			return
		}
	}
	recorder := &cacheRecorder{target: w, header: http.Header{}}
	next.ServeHTTP(recorder, r)
	entry, ok := recorder.finish()
	if !ok {
		return
	}
	entry.write(w, r, "MISS", ttl, anonymous)
	_ = http.NewResponseController(w).Flush()
	raw, _ := json.Marshal(entry)
	ctx, cancel := context.WithTimeout(context.WithoutCancel(r.Context()), responseCacheStoreTimeout)
	defer cancel()
	if err := c.store.Set(ctx, key, raw, ttl); err != nil {
		c.storeFailed(ctx, "write", err)
	}
}

// storeFailed bypasses the store for responseCacheBackoff, warning once per
// outage rather than once per request.
func (c *ResponseCache) storeFailed(ctx context.Context, operation string, err error) {
	now := time.Now()
	if previous := c.retryAt.Swap(now.Add(responseCacheBackoff).UnixNano()); previous <= now.UnixNano() {
		slog.WarnContext(ctx, "response cache "+operation+" failed; serving uncached", "retry_in", responseCacheBackoff.String(), "error", err)
	}
}

// key scopes entries to the caller: the bound identity (tenant, subject,
// actor, scopes and roles), or anonymous when the request carries no
// credentials. A request with credentials but no identity is not cached, so
// one caller never receives a response rendered for another.
func (c *ResponseCache) key(r *http.Request, namespace string) (key string, anonymous bool, ok bool) {
	hash := sha256.New()
	write := func(part string) {
		hash.Write([]byte(part))
		hash.Write([]byte{0})
	}
	for _, part := range []string{
		r.Method, r.Host, r.URL.EscapedPath(), r.URL.Query().Encode(),
		r.Header.Get("Accept"), r.Header.Get("Accept-Language"),
	} {
		write(part)
	}
	switch id, bound := identity.FromContext(r.Context()); {
	case bound && (id.TenantID != uuid.Nil || id.Subject != ""):
		write(id.TenantID.String())
		write(id.Subject)
		write(id.Actor)
		for _, values := range [][]string{id.Scopes, id.Roles} {
			sorted := slices.Compact(slices.Sorted(slices.Values(values)))
			write(strconv.Itoa(len(sorted)))
			for _, value := range sorted {
				write(value)
			}
		}
	case r.Header.Get("Authorization") != "" || r.Header.Get("Cookie") != "":
		return "", false, false
	default:
		anonymous = true
		write("anonymous")
	}
	return c.prefix + ":" + namespace + ":" + hex.EncodeToString(hash.Sum(nil)), anonymous, true
}

// write sends entry with its status header. The handler's Cache-Control is
// kept; without one, max-age is the time the entry has left. Entries cached
// per identity are marked private.
func (entry *cachedResponse) write(w http.ResponseWriter, r *http.Request, status string, maxAge time.Duration, anonymous bool) {
	header := w.Header()
	for name, values := range entry.Header {
		header[name] = slices.Clone(values)
	}
	control := header.Values("Cache-Control")
	if len(headerTokens(control)) == 0 {
		control = []string{"max-age=" + strconv.Itoa(ceilSeconds(maxAge))}
	}
	if directives := cacheControl(control); !anonymous && !directives["private"] && !directives["public"] {
		control = append(control, "private")
	}
	header.Set("Cache-Control", strings.Join(control, ", "))
	header.Set("ETag", entry.ETag)
	header.Set(ResponseCacheStatusHeader, status)
	if status == "HIT" && etagMatches(r.Header.Values("If-None-Match"), entry.ETag) {
		header.Del("Content-Type")
		w.WriteHeader(http.StatusNotModified)
		return
	}
	header.Set("Content-Length", strconv.Itoa(len(entry.Body)))
	w.WriteHeader(entry.Status)
	_, _ = w.Write(entry.Body)
}

// varyKeyed are the request headers the key already covers (Authorization via
// the identity scope).
var varyKeyed = map[string]bool{"accept": true, "accept-language": true, "authorization": true}

// hopByHopHeaders describe one connection and are never stored.
var hopByHopHeaders = []string{
	"Connection", "Keep-Alive", "Proxy-Authenticate", "Proxy-Authorization", "Proxy-Connection",
	"Te", "Trailer", "Transfer-Encoding", "Upgrade",
}

// cacheRecorder buffers a 200 response so it can be stored. Any other status,
// a body over maxCachedBodyBytes or a flush streams straight to the client.
type cacheRecorder struct {
	target    http.ResponseWriter
	header    http.Header
	status    int
	body      bytes.Buffer
	streaming bool
}

func (rec *cacheRecorder) Header() http.Header {
	if rec.streaming {
		return rec.target.Header()
	}
	return rec.header
}

func (rec *cacheRecorder) WriteHeader(status int) {
	if rec.status == 0 && status >= 200 {
		rec.status = status
	}
}

func (rec *cacheRecorder) Write(p []byte) (int, error) {
	rec.WriteHeader(http.StatusOK)
	if !rec.streaming && (rec.status != http.StatusOK || rec.body.Len()+len(p) > maxCachedBodyBytes) {
		rec.stream()
	}
	if rec.streaming {
		return rec.target.Write(p)
	}
	return rec.body.Write(p)
}

// FlushError stops buffering, so streamed responses (SSE) pass through
// uncached.
func (rec *cacheRecorder) FlushError() error {
	rec.WriteHeader(http.StatusOK)
	if !rec.streaming {
		rec.stream()
	}
	return http.NewResponseController(rec.target).Flush()
}

// Flush implements http.Flusher; see FlushError.
func (rec *cacheRecorder) Flush() { _ = rec.FlushError() }

// Unwrap lets http.ResponseController reach the underlying writer.
func (rec *cacheRecorder) Unwrap() http.ResponseWriter { return rec.target }

func (rec *cacheRecorder) stream() {
	rec.streaming = true
	header := rec.target.Header()
	for name, values := range rec.header {
		header[name] = values
	}
	rec.target.WriteHeader(rec.status)
	if rec.body.Len() > 0 {
		_, _ = rec.target.Write(rec.body.Bytes())
	}
}

// finish returns the entry to store, or forwards the response unchanged when
// it is not cacheable: a non-200 status, Set-Cookie, a Cache-Control of
// no-store or private, or a Vary on a header the key does not cover.
func (rec *cacheRecorder) finish() (cachedResponse, bool) {
	rec.WriteHeader(http.StatusOK)
	if rec.streaming {
		return cachedResponse{}, false
	}
	directives := cacheControl(rec.header.Values("Cache-Control"))
	cacheable := rec.status == http.StatusOK && rec.header.Get("Set-Cookie") == "" &&
		!directives["no-store"] && !directives["private"]
	for _, name := range headerTokens(rec.header.Values("Vary")) {
		cacheable = cacheable && varyKeyed[name]
	}
	if !cacheable {
		rec.stream()
		return cachedResponse{}, false
	}
	header := rec.header.Clone()
	for _, name := range headerTokens(header.Values("Connection")) {
		header.Del(name)
	}
	for _, name := range hopByHopHeaders {
		header.Del(name)
	}
	header.Del("Content-Length")
	header.Del("Date")
	sum := sha256.Sum256(rec.body.Bytes())
	return cachedResponse{
		Status: rec.status,
		Header: header,
		Body:   bytes.Clone(rec.body.Bytes()),
		ETag:   `W/"` + hex.EncodeToString(sum[:16]) + `"`,
	}, true
}

func cacheControl(values []string) map[string]bool {
	directives := map[string]bool{}
	for _, token := range headerTokens(values) {
		name, _, _ := strings.Cut(token, "=")
		directives[name] = true
	}
	return directives
}

// headerTokens splits comma-separated header values into lower-case tokens.
func headerTokens(values []string) []string {
	var tokens []string
	for _, value := range values {
		for _, token := range strings.Split(value, ",") {
			if token = strings.ToLower(strings.TrimSpace(token)); token != "" {
				tokens = append(tokens, token)
			}
		}
	}
	return tokens
}

func etagMatches(values []string, etag string) bool {
	weak := strings.TrimPrefix(etag, "W/")
	for _, value := range values {
		for _, candidate := range strings.Split(value, ",") {
			candidate = strings.TrimSpace(candidate)
			if candidate == "*" || strings.TrimPrefix(candidate, "W/") == weak {
				return true
			}
		}
	}
	return false
}

func ceilSeconds(d time.Duration) int {
	return int((d + time.Second - 1) / time.Second)
}

// MemoryResponseCacheStore is the per-process store: least recently used
// entries are evicted once the stored bytes exceed the bound.
type MemoryResponseCacheStore struct {
	mu       sync.Mutex
	maxBytes int
	size     int
	entries  map[string]*list.Element
	lru      *list.List
}

type memoryCacheEntry struct {
	key     string
	value   []byte
	expires time.Time
}

// NewMemoryResponseCacheStore bounds the store to maxBytes of entries;
// zero or less means DefaultResponseCacheMemoryBytes.
func NewMemoryResponseCacheStore(maxBytes int) *MemoryResponseCacheStore {
	if maxBytes <= 0 {
		maxBytes = DefaultResponseCacheMemoryBytes
	}
	return &MemoryResponseCacheStore{maxBytes: maxBytes, entries: map[string]*list.Element{}, lru: list.New()}
}

// Get returns the entry and its remaining ttl.
func (s *MemoryResponseCacheStore) Get(_ context.Context, key string) ([]byte, time.Duration, bool, error) {
	s.mu.Lock()
	defer s.mu.Unlock()
	element, ok := s.entries[key]
	if !ok {
		return nil, 0, false, nil
	}
	entry := element.Value.(*memoryCacheEntry)
	remaining := time.Until(entry.expires)
	if remaining <= 0 {
		s.remove(element)
		return nil, 0, false, nil
	}
	s.lru.MoveToFront(element)
	return entry.value, remaining, true, nil
}

// Set stores entry for ttl; an entry larger than the bound is not stored.
func (s *MemoryResponseCacheStore) Set(_ context.Context, key string, entry []byte, ttl time.Duration) error {
	s.mu.Lock()
	defer s.mu.Unlock()
	if element, ok := s.entries[key]; ok {
		s.remove(element)
	}
	if len(entry) > s.maxBytes {
		return nil
	}
	s.entries[key] = s.lru.PushFront(&memoryCacheEntry{key: key, value: entry, expires: time.Now().Add(ttl)})
	s.size += len(entry)
	for s.size > s.maxBytes {
		s.remove(s.lru.Back())
	}
	return nil
}

// Clear deletes every key starting with prefix.
func (s *MemoryResponseCacheStore) Clear(_ context.Context, prefix string) error {
	s.mu.Lock()
	defer s.mu.Unlock()
	for key, element := range s.entries {
		if strings.HasPrefix(key, prefix) {
			s.remove(element)
		}
	}
	return nil
}

func (s *MemoryResponseCacheStore) remove(element *list.Element) {
	entry := s.lru.Remove(element).(*memoryCacheEntry)
	delete(s.entries, entry.key)
	s.size -= len(entry.value)
}
