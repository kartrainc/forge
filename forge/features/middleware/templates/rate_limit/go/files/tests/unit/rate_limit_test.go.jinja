func limitedHandler(options middleware.RateLimitOptions) http.Handler {
	return middleware.RateLimit(options)(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		w.WriteHeader(http.StatusNoContent)
	}))
}

func sendFrom(handler http.Handler, remoteAddr, path string, header map[string]string) *httptest.ResponseRecorder {
	request := httptest.NewRequest(http.MethodGet, path, nil)
	request.RemoteAddr = remoteAddr
	for name, value := range header {
		request.Header.Set(name, value)
	}
	recorder := httptest.NewRecorder()
	handler.ServeHTTP(recorder, request)
	return recorder
}

func TestRateLimitDefaultsAllowBurstThenRejectWithEnvelope(t *testing.T) {
	handler := limitedHandler(middleware.RateLimitOptions{})
	for i := range 120 {
		if code := sendFrom(handler, "198.51.100.7:4000", "/api/v1/items", nil).Code; code != http.StatusNoContent {
			t.Fatalf("request %d: status %d", i, code)
		}
	}
	recorder := sendFrom(handler, "198.51.100.7:4000", "/api/v1/items", nil)
	if recorder.Code != http.StatusTooManyRequests {
		t.Fatalf("status %d", recorder.Code)
	}
	retryAfter, err := strconv.Atoi(recorder.Header().Get("Retry-After"))
	if err != nil || retryAfter < 1 {
		t.Fatalf("Retry-After %q", recorder.Header().Get("Retry-After"))
	}
	var envelope testutil.Envelope
	if err := json.Unmarshal(recorder.Body.Bytes(), &envelope); err != nil {
		t.Fatal(err)
	}
	if envelope.Error.Code != "RATE_LIMITED" || envelope.Error.Context["retry_after"] != float64(retryAfter) {
		t.Fatalf("envelope %+v", envelope)
	}
	if code := sendFrom(handler, "198.51.100.8:4000", "/api/v1/items", nil).Code; code != http.StatusNoContent {
		t.Fatalf("another client shares the bucket: %d", code)
	}
}

func TestRateLimitSkipsProbePaths(t *testing.T) {
	handler := limitedHandler(middleware.RateLimitOptions{RequestsPerMinute: 1})
	for _, path := range []string{"/health", "/metrics", "/api/v1/health/live", "/api/v1/health/ready"} {
		for range 3 {
			if code := sendFrom(handler, "198.51.100.7:4000", path, nil).Code; code != http.StatusNoContent {
				t.Fatalf("%s: status %d", path, code)
			}
		}
	}
	custom := limitedHandler(middleware.RateLimitOptions{RequestsPerMinute: 1, SkipPaths: []string{"/open"}})
	sendFrom(custom, "198.51.100.7:4000", "/api/v1/health/live", nil)
	if code := sendFrom(custom, "198.51.100.7:4000", "/api/v1/health/live", nil).Code; code != http.StatusTooManyRequests {
		t.Fatalf("custom skip paths replace the defaults: %d", code)
	}
}

// withIdentity binds ident to each request; verified marks its token as
// verified by the platform-auth middleware.
func withIdentity(ident identity.IdentityContext, verified bool, next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		ctx := identity.WithContext(r.Context(), ident)
{%- if options['auth.mode'] == 'generate' %}
		if verified {
			ctx = platformauth.WithIdentity(ctx, platformauth.IdentityContext{TenantID: ident.TenantID, Subject: ident.Subject})
		}
{%- endif %}
		next.ServeHTTP(w, r.WithContext(ctx))
	})
}

func TestRateLimitKeysVerifiedTenantsAcrossAddresses(t *testing.T) {
	limiter := middleware.RateLimit(middleware.RateLimitOptions{RequestsPerMinute: 1})
	handler := withIdentity(identity.New(uuid.New(), "subject"), true, limiter(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		w.WriteHeader(http.StatusNoContent)
	})))
	if code := sendFrom(handler, "198.51.100.1:1", "/api/v1/items", nil).Code; code != http.StatusNoContent {
		t.Fatalf("first tenant request: %d", code)
	}
	second := sendFrom(handler, "198.51.100.2:1", "/api/v1/items", nil).Code
{%- if options['auth.mode'] == 'generate' %}
	if second != http.StatusTooManyRequests {
		t.Fatalf("the bucket of a verified tenant follows the tenant, not the address: %d", second)
	}
{%- else %}
	if second != http.StatusNoContent {
		t.Fatalf("without platform auth nothing is verified, so the address keys the bucket: %d", second)
	}
{%- endif %}
}

func TestRateLimitIgnoresAnUnverifiedTenant(t *testing.T) {
	limiter := middleware.RateLimit(middleware.RateLimitOptions{RequestsPerMinute: 1})
	ok := limiter(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
		w.WriteHeader(http.StatusNoContent)
	}))
	// A tenant the client chose (a tenant header without a verified token)
	// buys no fresh bucket: the address keys it.
	if code := sendFrom(withIdentity(identity.New(uuid.New(), "subject"), false, ok), "198.51.100.3:1", "/", nil).Code; code != http.StatusNoContent {
		t.Fatalf("first request: %d", code)
	}
	if code := sendFrom(withIdentity(identity.New(uuid.New(), "subject"), false, ok), "198.51.100.3:1", "/", nil).Code; code != http.StatusTooManyRequests {
		t.Fatalf("another unverified tenant from the same address: %d", code)
	}
}

func TestRateLimitTrustsForwardedForOnlyFromPrivatePeers(t *testing.T) {
	handler := limitedHandler(middleware.RateLimitOptions{RequestsPerMinute: 1})
	for p, proxy := range []string{"10.0.0.2:80", "127.0.0.1:80", "[fd00::1]:80", "[fe80::1]:80", "[::ffff:192.168.1.1]:80"} {
		clients := []string{fmt.Sprintf("203.0.113.%d", 2*p+1), fmt.Sprintf("203.0.113.%d, 10.0.0.9", 2*p+2)}
		for _, client := range clients {
			if code := sendFrom(handler, proxy, "/", map[string]string{"X-Forwarded-For": client}).Code; code != http.StatusNoContent {
				t.Fatalf("%s via %s: %d", client, proxy, code)
			}
		}
		sendFrom(handler, proxy, "/", nil)
		if code := sendFrom(handler, proxy, "/", map[string]string{"X-Forwarded-For": " "}).Code; code != http.StatusTooManyRequests {
			t.Fatalf("a blank forwarded address falls back to the peer: %d", code)
		}
	}
	public := "198.51.100.9:80"
	sendFrom(handler, public, "/", map[string]string{"X-Forwarded-For": "203.0.113.50"})
	if code := sendFrom(handler, public, "/", map[string]string{"X-Forwarded-For": "203.0.113.51"}).Code; code != http.StatusTooManyRequests {
		t.Fatalf("a public peer cannot pick its bucket via X-Forwarded-For: %d", code)
	}
}

func TestRateLimitReadsForwardedForFromTheTrustedEnd(t *testing.T) {
	handler := limitedHandler(middleware.RateLimitOptions{RequestsPerMinute: 1})
	proxy := "10.0.0.2:80"
	// The client prepends whatever it likes; the proxy appends the address it saw.
	sendFrom(handler, proxy, "/", map[string]string{"X-Forwarded-For": "1.1.1.1, 198.51.100.77"})
	if code := sendFrom(handler, proxy, "/", map[string]string{"X-Forwarded-For": "2.2.2.2, 198.51.100.77"}).Code; code != http.StatusTooManyRequests {
		t.Fatalf("a rotated client-supplied entry must not select a fresh bucket: %d", code)
	}
	// Several headers form one list.
	request := httptest.NewRequest(http.MethodGet, "/", nil)
	request.RemoteAddr = proxy
	request.Header.Add("X-Forwarded-For", "3.3.3.3")
	request.Header.Add("X-Forwarded-For", "198.51.100.77")
	recorder := httptest.NewRecorder()
	handler.ServeHTTP(recorder, request)
	if recorder.Code != http.StatusTooManyRequests {
		t.Fatalf("repeated headers are one list: %d", recorder.Code)
	}
	// A chain of trusted hops resolves to its leftmost hop; a malformed entry stops the walk.
	if code := sendFrom(handler, proxy, "/", map[string]string{"X-Forwarded-For": "10.1.1.1, 10.0.0.9"}).Code; code != http.StatusNoContent {
		t.Fatalf("internal client: %d", code)
	}
	if code := sendFrom(handler, proxy, "/", map[string]string{"X-Forwarded-For": "198.51.100.88, garbage, 10.0.0.9"}).Code; code != http.StatusNoContent {
		t.Fatalf("malformed entry: %d", code)
	}
	if code := sendFrom(handler, proxy, "/", map[string]string{"X-Forwarded-For": "198.51.100.89, garbage, 10.0.0.9"}).Code; code != http.StatusTooManyRequests {
		t.Fatalf("left of a malformed entry is not trusted: %d", code)
	}
}

func TestRateLimitUnusualRemoteAddresses(t *testing.T) {
	handler := limitedHandler(middleware.RateLimitOptions{RequestsPerMinute: 1})
	for _, remote := range []string{"", "not-an-ip", "198.51.100.20"} {
		sendFrom(handler, remote, "/", nil)
		if code := sendFrom(handler, remote, "/", nil).Code; code != http.StatusTooManyRequests {
			t.Fatalf("remote %q: %d", remote, code)
		}
	}
}

func TestRateLimitRefillsOverTime(t *testing.T) {
	handler := limitedHandler(middleware.RateLimitOptions{RequestsPerMinute: 60000, Burst: 1})
	sendFrom(handler, "198.51.100.7:1", "/", nil)
	if code := sendFrom(handler, "198.51.100.7:1", "/", nil).Code; code != http.StatusTooManyRequests {
		t.Fatalf("burst of one: %d", code)
	}
	time.Sleep(5 * time.Millisecond)
	if code := sendFrom(handler, "198.51.100.7:1", "/", nil).Code; code != http.StatusNoContent {
		t.Fatalf("bucket refills: %d", code)
	}
}

func TestRateLimitEvictsLeastRecentlyUsedClients(t *testing.T) {
	handler := limitedHandler(middleware.RateLimitOptions{RequestsPerMinute: 1})
	first := "198.51.100.7:1"
	sendFrom(handler, first, "/", nil)
	sendFrom(handler, "198.51.100.8:1", "/", nil)
	if code := sendFrom(handler, first, "/", nil).Code; code != http.StatusTooManyRequests {
		t.Fatalf("exhausted: %d", code)
	}
	for i := range 4096 {
		sendFrom(handler, fmt.Sprintf("[2001:db8::%x]:1", i+1), "/", nil)
	}
	if code := sendFrom(handler, first, "/", nil).Code; code != http.StatusNoContent {
		t.Fatalf("evicted clients start with a full bucket: %d", code)
	}
}
