<script setup lang="ts">
// The built-in sign-in page (routing.sign_in: builtin), on the application's auth contract. Generated by forge.
import { onMounted, ref } from 'vue'
import { useRoute, useRouter } from 'vue-router'
import { application } from '@/shared/application/config'
import { useApplicationAuth } from '@/shared/application/context'

const router = useRouter()
const route = useRoute()
const auth = useApplicationAuth()
const authDisabled = import.meta.env.VITE_AUTH_DISABLED === 'true'
const busy = ref(false)

function target(): string {
  const redirect = route.query.redirect
  return typeof redirect === 'string' && redirect.startsWith('/') ? redirect : router.resolve({ name: application.routing.landing ?? 'not-found' }).fullPath
}

onMounted(() => {
  if (auth.isAuthenticated.value) void router.replace(target())
})

async function signIn() {
  busy.value = true
  try {
    // forge's runtime leaves the page for the gateway; a contract that signs in
    // in place returns here signed in.
    await auth.signIn(target())
    if (auth.isAuthenticated.value) await router.replace(target())
  } finally {
    busy.value = false
  }
}
</script>

<template>
  <div class="flex min-h-svh items-center justify-center bg-muted p-4">
    <UCard class="w-full max-w-sm" :ui="{ body: 'p-8 sm:p-8 space-y-6 text-center' }">
      <div>
        <h1 class="text-2xl font-semibold text-highlighted">{{ application.title }}</h1>
        <p class="mt-1.5 text-sm text-muted">Sign in to continue</p>
      </div>
      <UButton
        data-test="login-submit-btn"
        label="Sign in"
        icon="i-lucide-log-in"
        :loading="busy"
        size="xl"
        block
        @click="signIn"
      />
      <UBadge v-if="authDisabled" label="Dev Mode - Auth Disabled" color="warning" variant="subtle" />
    </UCard>
  </div>
</template>
