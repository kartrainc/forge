<script setup lang="ts">
/**
 * The `header-sidebar` shell (ADR-015): a full-width header with the logo, a centre and
 * the actions; under it a collapsible sidebar rendering the layout's primary menu, the
 * page with a footer, and a right-hand panel that collapses on wide screens and slides
 * over the page on narrow ones; the two edge toggles. Built from Nuxt UI's dashboard
 * components. A project fills the slots by wrapping the shell in a component of its own
 * and passing that wrapper to createApplicationRouter(); the props pass its sizes,
 * breakpoints and menu options through to them. Generated by forge.
 */
import { computed, ref, useSlots, watch } from 'vue'
import { onKeyStroke, useLocalStorage, useMediaQuery } from '@vueuse/core'
import { useRoute } from 'vue-router'
import type { DashboardSidebarProps, NavigationMenuProps, SlideoverProps } from '@nuxt/ui'
import { application } from '@/shared/application/config'
import { useApplicationDropdown, useApplicationMenu, useOpenMenuItems } from '@/shared/application/menus'

/** From which width a region is wide: a number of pixels, or a media query that matches when it is. */
type Breakpoint = number | string
type Ui = Record<string, unknown>

/** The right-hand panel's state and its toggle, for a trigger of the project's own. */
interface AsideControl {
  /** Docked beside the page and expanded, or slid over it. */
  open: boolean
  /** Docked beside the page (a wide screen), or sliding over it (a narrow one). */
  docked: boolean
  toggle: () => void
}

const props = withDefaults(defineProps<{
  /** The layout whose menus the shell renders. */
  layout: string
  /** A badge on the right panel's edge toggle (unread messages, for example). */
  asideBadge?: number | string
  /** UDashboardSidebar props over the shell's: sizes, `resizable`, the narrow screen's `mode` and `menu`. */
  sidebar?: Omit<DashboardSidebarProps, 'id' | 'side'>
  /** Props for the docked right panel (a UDashboardSidebar on the right) over the shell's: sizes, `resizable`. */
  aside?: Pick<DashboardSidebarProps, 'defaultSize' | 'minSize' | 'maxSize' | 'resizable' | 'class' | 'ui'>
  /** UNavigationMenu props of the primary menu over the shell's: `type`, `tooltip`, `popover`, `ui`. */
  menu?: Omit<NavigationMenuProps, 'items' | 'modelValue' | 'defaultValue' | 'orientation' | 'collapsed'>
  /** Where the sidebar, the right panel and the header turn narrow; 1024 px each by default. */
  breakpoints?: { sidebar?: Breakpoint, aside?: Breakpoint, header?: Breakpoint }
  /** The sidebar on narrow screens: behind a menu button (`menu`), or kept as icons (`collapsed`). */
  narrowSidebar?: 'menu' | 'collapsed'
  /** The header's "Show panel" button on narrow screens; off when the project renders its own trigger. */
  asideButton?: boolean
  /** USlideover props for the right panel on narrow screens over the shell's: `overlay`, `modal`, `transition`, `title`, `ui`. */
  asideSlideover?: Omit<SlideoverProps, 'open' | 'side'>
}>(), {
  asideBadge: undefined,
  sidebar: () => ({}),
  aside: () => ({}),
  menu: () => ({}),
  breakpoints: () => ({}),
  narrowSidebar: 'menu',
  asideButton: true,
  asideSlideover: () => ({}),
})

defineSlots<{
  logo?(props: { collapsed: boolean, narrow: boolean, sidebarNarrow: boolean }): unknown
  header?(props: { narrow: boolean, expanded: boolean, collapse: () => void, sidebarNarrow: boolean }): unknown
  actions?(props: { narrow: boolean, expandHeader: () => void, account: ReturnType<typeof useApplicationDropdown>['value'], sidebarNarrow: boolean, aside: AsideControl }): unknown
  default?(): unknown
  footer?(props: { items: ReturnType<typeof useApplicationMenu>['value'] }): unknown
  aside?(props: { close: () => void, docked: boolean }): unknown
  /** Rendered at the shell's root, after the page: a trigger of the project's own, which positions it. */
  'aside-trigger'?(props: AsideControl): unknown
  /** The sidebar's edge toggle, in the page's box at its left edge, on wide screens. */
  'sidebar-toggle'?(props: { collapsed: boolean, toggle: () => void }): unknown
  /** The right panel's edge toggle, in the page's box at its right edge, while it docks. */
  'aside-toggle'?(props: { collapsed: boolean, toggle: () => void }): unknown
}>()

const slots = useSlots()
const route = useRoute()
const primary = useApplicationMenu(props.layout, 'primary')
// Controlled, so the open sub-menu follows navigation, not only the first render.
const openItems = useOpenMenuItems(props.layout, 'primary')
const account = useApplicationDropdown(props.layout, 'account')
const footer = useApplicationMenu(props.layout, 'footer')
const hasAccount = computed(() => account.value.some(group => group.some(item => item.type !== 'label')))
const hasFooter = computed(() => footer.value.some(group => group.length > 0))

function query(breakpoint: Breakpoint = 1024): string {
  return typeof breakpoint === 'number' ? `(min-width: ${breakpoint}px)` : breakpoint
}
const headerWide = useMediaQuery(() => query(props.breakpoints.header))
const sidebarWide = useMediaQuery(() => query(props.breakpoints.sidebar))
const asideDocked = useMediaQuery(() => query(props.breakpoints.aside))
const narrow = computed(() => !headerWide.value)
const sidebarNarrow = computed(() => !sidebarWide.value)
// `wide`, `menu` (hidden behind the header's menu button) or `icons` (kept, collapsed).
const sidebarMode = computed(() => (sidebarWide.value ? 'wide' : props.narrowSidebar === 'collapsed' ? 'icons' : 'menu'))
const storageKey = `shell-${props.layout}`
const collapsed = useLocalStorage(`${storageKey}-sidebar-collapsed`, false)
const sidebarCollapsed = computed(() => sidebarMode.value === 'icons' || collapsed.value)
const asideCollapsed = useLocalStorage(`${storageKey}-aside-collapsed`, false)
const asideOpen = ref(false)
const menuOpen = ref(false)
const headerExpanded = ref(false)
const landing = computed(() => (application.routing.landing ? { name: application.routing.landing } : '/'))

// A narrow screen's overlays close when the page changes, and when their region turns wide.
watch(() => route.fullPath, () => {
  asideOpen.value = false
  headerExpanded.value = false
})
watch(asideDocked, (docked) => {
  if (docked) asideOpen.value = false
})
watch(headerWide, (wide) => {
  if (wide) headerExpanded.value = false
})
watch(sidebarWide, (wide) => {
  if (wide) menuOpen.value = false
})
onKeyStroke('Escape', (event) => {
  if (narrow.value && headerExpanded.value && !event.defaultPrevented) headerExpanded.value = false
})

function toggleSidebar() {
  collapsed.value = !collapsed.value
}
function onSidebarCollapsed(value: boolean) {
  // The icons of a narrow screen are no choice of the user's: the wide screen's stays.
  if (sidebarMode.value !== 'icons') collapsed.value = value
}
function toggleAside() {
  if (asideDocked.value) asideCollapsed.value = !asideCollapsed.value
  else asideOpen.value = !asideOpen.value
}
const asideControl = computed<AsideControl>(() => ({
  open: asideDocked.value ? !asideCollapsed.value : asideOpen.value,
  docked: asideDocked.value,
  toggle: toggleAside,
}))

/** The shell's `ui` classes with the project's after them, so tailwind-merge lets the project's win. */
function mergeUi(own: Ui, project: Ui | undefined): Ui {
  const merged: Ui = { ...own }
  for (const [slot, classes] of Object.entries(project ?? {})) merged[slot] = slot in own ? [own[slot], classes] : classes
  return merged
}

// Nuxt UI shows the sidebar from `lg` and its menu below it; the shell's breakpoint decides instead.
const sidebarUi = computed<Ui>(() => (sidebarMode.value === 'menu'
  ? { root: 'min-h-0 hidden lg:hidden', handle: 'lg:hidden', toggle: 'lg:inline-flex', content: 'lg:flex', overlay: 'lg:block' }
  : { root: 'min-h-0 flex', handle: 'block' }))
const sidebarProps = computed(() => ({
  collapsible: true,
  collapsedSize: 4,
  defaultSize: 16,
  minSize: 12,
  maxSize: 22,
  ...props.sidebar,
  // The icons of a narrow screen are a sidebar of their own, neither resizable nor stored.
  ...(sidebarMode.value === 'icons'
    ? { id: `${props.layout}-sidebar-narrow`, collapsible: false, resizable: false }
    : { id: `${props.layout}-sidebar` }),
  ui: mergeUi(sidebarUi.value, props.sidebar.ui as Ui | undefined),
}))

// A right-hand UDashboardSidebar puts its resize handle on its inner edge and resizes
// towards the page; it draws the line to the page inside its own width. Folded, it keeps
// its place at no width rather than leaving the page, so its content stays and a project
// can animate the fold (the width) in its own CSS.
const asideProps = computed(() => ({
  defaultSize: 22,
  minSize: 16,
  maxSize: 32,
  resizable: true,
  ...props.aside,
  collapsible: true,
  collapsedSize: 0,
  ui: mergeUi({ root: 'flex min-h-0 min-w-0 border-s border-default data-[collapsed=true]:border-s-0', body: 'p-0', handle: 'block' }, props.aside.ui as Ui | undefined),
}))
const slideoverProps = computed(() => ({ title: 'Panel', ...props.asideSlideover, ui: mergeUi({ body: 'p-0 sm:p-0' }, props.asideSlideover.ui as Ui | undefined) }))

// The single type takes one open sub-menu, the multiple type a list. None open is '':
// undefined would leave the menu to its own state.
const openModel = computed({
  get: () => (props.menu.type === 'single' ? (openItems.value[0] ?? '') : openItems.value),
  set: (value: string | string[] | undefined) => {
    openItems.value = Array.isArray(value) ? value : value ? [value] : []
  },
})
function menuProps(isCollapsed: boolean) {
  // A collapsed menu hides its labels (`hidden`), which leaves its items without a name:
  // they stay for assistive technology. tailwind-merge keeps `hidden` beside `sr-only`;
  // `inline` replaces it.
  const ui = mergeUi(isCollapsed ? { linkLabel: 'inline sr-only' } : {}, props.menu.ui as Ui | undefined)
  return { tooltip: true, popover: true, ...props.menu, ui }
}
</script>

<template>
  <!--
    Nuxt UI stores a collapsible sidebar's size with its collapse, and a stored size wins
    over the configured one: only a size the user can change is stored. The shell stores
    the collapse itself.
  -->
  <UDashboardGroup unit="rem" storage="local" :storage-key="storageKey" :persistent="!!sidebarProps.resizable" class="flex-col">
    <header
      class="relative z-20 flex h-(--ui-header-height) shrink-0 items-center gap-3 border-b border-default bg-default px-4"
      data-shell="header"
    >
      <template v-if="narrow && headerExpanded">
        <div class="min-w-0 flex-1">
          <slot name="header" :narrow="narrow" :expanded="true" :collapse="() => (headerExpanded = false)" :sidebar-narrow="sidebarNarrow" />
        </div>
        <UButton icon="i-lucide-x" color="neutral" variant="ghost" aria-label="Close" @click="headerExpanded = false" />
      </template>
      <template v-else>
        <UDashboardSidebarToggle v-if="sidebarMode === 'menu'" class="lg:inline-flex" />
        <slot name="logo" :collapsed="sidebarCollapsed" :narrow="narrow" :sidebar-narrow="sidebarNarrow">
          <RouterLink :to="landing" class="truncate font-semibold text-highlighted">{{ application.title }}</RouterLink>
        </slot>
        <div class="flex min-w-0 flex-1 justify-center">
          <slot v-if="!narrow" name="header" :narrow="false" :expanded="false" :collapse="() => {}" :sidebar-narrow="sidebarNarrow" />
        </div>
        <div class="flex shrink-0 items-center gap-2">
          <slot name="actions" :narrow="narrow" :expand-header="() => (headerExpanded = true)" :account="account" :sidebar-narrow="sidebarNarrow" :aside="asideControl">
            <UDropdownMenu v-if="hasAccount" :items="account" :content="{ align: 'end' }">
              <UButton icon="i-lucide-circle-user" color="neutral" variant="ghost" aria-label="Account" />
              <template #item-trailing="{ item }">
                <UBadge v-if="item.badge !== undefined" :label="String(item.badge)" size="sm" variant="subtle" data-shell="account-badge" />
              </template>
            </UDropdownMenu>
          </slot>
          <UButton
            v-if="slots.aside && !asideDocked && asideButton"
            icon="i-lucide-panel-right"
            color="neutral"
            variant="ghost"
            aria-label="Show panel"
            @click="toggleAside"
          />
        </div>
      </template>
    </header>

    <div class="relative flex min-h-0 flex-1">
      <!-- The icons of a narrow screen and the wide sidebar keep their states apart. -->
      <UDashboardSidebar
        :key="sidebarMode === 'icons' ? 'icons' : 'sidebar'"
        v-bind="sidebarProps"
        v-model:open="menuOpen"
        :collapsed="sidebarCollapsed"
        @update:collapsed="onSidebarCollapsed"
      >
        <template #default="{ collapsed: isCollapsed }">
          <UNavigationMenu
            v-bind="menuProps(isCollapsed)"
            v-model="openModel"
            :items="primary"
            orientation="vertical"
            :collapsed="isCollapsed"
            aria-label="Main"
          />
        </template>
      </UDashboardSidebar>

      <UDashboardPanel :id="`${layout}-main`" :ui="{ root: 'min-h-0 lg:not-last:border-e-0' }">
        <div class="relative flex min-h-0 flex-1 flex-col">
          <template v-if="sidebarMode === 'wide'">
            <slot name="sidebar-toggle" :collapsed="collapsed" :toggle="toggleSidebar">
              <UTooltip :text="collapsed ? 'Expand menu' : 'Collapse menu'" :content="{ side: 'right' }">
                <UButton
                  class="absolute top-1/2 left-0 z-10 -translate-x-1/2 -translate-y-1/2 rounded-full"
                  size="xs"
                  color="neutral"
                  variant="outline"
                  :icon="collapsed ? 'i-lucide-chevron-right' : 'i-lucide-chevron-left'"
                  :aria-label="collapsed ? 'Expand menu' : 'Collapse menu'"
                  :aria-expanded="!collapsed"
                  data-shell="sidebar-toggle"
                  @click="toggleSidebar"
                />
              </UTooltip>
            </slot>
          </template>
          <div class="flex min-h-0 flex-1 flex-col overflow-y-auto">
            <main class="flex-1 p-4 sm:p-6">
              <slot>
                <RouterView />
              </slot>
            </main>
            <footer v-if="slots.footer || hasFooter" class="border-t border-default px-4 py-3 sm:px-6">
              <slot name="footer" :items="footer">
                <UNavigationMenu :items="footer" orientation="horizontal" aria-label="Footer" />
              </slot>
            </footer>
          </div>
          <template v-if="slots.aside && asideDocked">
            <slot name="aside-toggle" :collapsed="asideCollapsed" :toggle="toggleAside">
              <UTooltip :text="asideCollapsed ? 'Show panel' : 'Hide panel'" :content="{ side: 'left' }">
                <UButton
                  class="absolute top-1/2 right-0 z-10 translate-x-1/2 -translate-y-1/2 rounded-full"
                  size="xs"
                  color="neutral"
                  variant="outline"
                  :icon="asideCollapsed ? 'i-lucide-chevron-left' : 'i-lucide-chevron-right'"
                  :aria-label="asideCollapsed ? 'Show panel' : 'Hide panel'"
                  :aria-expanded="!asideCollapsed"
                  data-shell="aside-toggle"
                  @click="toggleAside"
                />
              </UTooltip>
              <UBadge
                v-if="asideBadge !== undefined && asideCollapsed"
                :label="String(asideBadge)"
                color="error"
                size="sm"
                class="absolute top-1/2 right-0 z-20 -translate-y-7 translate-x-1/2 rounded-full"
                data-shell="aside-badge"
              />
            </slot>
          </template>
        </div>
      </UDashboardPanel>

      <!--
        The docked right panel. Its own group keeps its state out of the group's sidebar
        state, which UDashboardSidebarCollapse and UDashboardSidebarToggle read, and renders
        no box (`contents`). Its menu never opens: a narrow screen slides the panel over
        the page below, and the sidebar toggle every sidebar hears leaves it closed. Folded,
        its content is inert.
      -->
      <UDashboardGroup
        v-if="slots.aside && asideDocked"
        unit="rem"
        storage="local"
        :storage-key="storageKey"
        :persistent="!!asideProps.resizable"
        class="contents"
      >
        <UDashboardSidebar
          :id="`${layout}-aside`"
          v-bind="asideProps"
          side="right"
          :collapsed="asideCollapsed"
          :open="false"
          :toggle="false"
          @update:collapsed="(value: boolean) => (asideCollapsed = value)"
          @update:open="() => {}"
        >
          <aside class="flex min-h-0 flex-1 flex-col" data-shell="aside" :inert="asideCollapsed || undefined">
            <slot name="aside" :close="() => (asideCollapsed = true)" :docked="true" />
          </aside>
        </UDashboardSidebar>
      </UDashboardGroup>
    </div>

    <USlideover v-if="slots.aside && !asideDocked" v-bind="slideoverProps" v-model:open="asideOpen" side="right">
      <template #body>
        <aside class="flex min-h-0 flex-1 flex-col" data-shell="aside">
          <slot name="aside" :close="() => (asideOpen = false)" :docked="false" />
        </aside>
      </template>
    </USlideover>

    <slot v-if="slots.aside" name="aside-trigger" v-bind="asideControl" />
  </UDashboardGroup>
</template>
