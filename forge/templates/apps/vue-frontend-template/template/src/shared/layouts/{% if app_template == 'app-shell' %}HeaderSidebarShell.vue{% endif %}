<script setup lang="ts">
/**
 * The `header-sidebar` shell (ADR-015): a full-width header with the logo, a centre and
 * the actions; under it a collapsible sidebar rendering the layout's primary menu, the
 * page with a footer, and a right-hand panel that collapses on wide screens and slides
 * over the page on narrow ones; the two edge toggles. Built from Nuxt UI's dashboard
 * components. A project fills the slots by wrapping the shell in a component of its own
 * and passing that wrapper to createApplicationRouter(). Generated by forge.
 */
import { computed, ref, useSlots, watch } from 'vue'
import { useLocalStorage, useMediaQuery } from '@vueuse/core'
import { useRoute } from 'vue-router'
import { application } from '@/shared/application/config'
import { useApplicationDropdown, useApplicationMenu, useOpenMenuItems } from '@/shared/application/menus'

const props = withDefaults(defineProps<{
  /** The layout whose menus the shell renders. */
  layout: string
  /** A badge on the right panel's edge toggle (unread messages, for example). */
  asideBadge?: number | string
}>(), { asideBadge: undefined })

defineSlots<{
  logo?(props: { collapsed: boolean }): unknown
  header?(props: { narrow: boolean, expanded: boolean, collapse: () => void }): unknown
  actions?(props: { narrow: boolean, expandHeader: () => void, account: ReturnType<typeof useApplicationDropdown>['value'] }): unknown
  default?(): unknown
  footer?(props: { items: ReturnType<typeof useApplicationMenu>['value'] }): unknown
  aside?(props: { close: () => void }): unknown
}>()

const slots = useSlots()
const route = useRoute()
const primary = useApplicationMenu(props.layout, 'primary')
// Controlled, so the open sub-menu follows navigation, not only the first render.
const openItems = useOpenMenuItems(props.layout, 'primary')
const account = useApplicationDropdown(props.layout, 'account')
const footer = useApplicationMenu(props.layout, 'footer')
const hasAccount = computed(() => account.value.some(group => group.some(item => item.type !== 'label')))
const hasFooter = computed(() => footer.value.some(group => group.length > 0))

const wide = useMediaQuery('(min-width: 1024px)')
const narrow = computed(() => !wide.value)
const storageKey = `shell-${props.layout}`
const collapsed = useLocalStorage(`${storageKey}-sidebar-collapsed`, false)
const asideCollapsed = useLocalStorage(`${storageKey}-aside-collapsed`, false)
const asideOpen = ref(false)
const headerExpanded = ref(false)
const landing = computed(() => (application.routing.landing ? { name: application.routing.landing } : '/'))

// A narrow screen's overlays close when the page changes.
watch(() => route.fullPath, () => {
  asideOpen.value = false
  headerExpanded.value = false
})
watch(wide, (isWide) => {
  if (isWide) {
    asideOpen.value = false
    headerExpanded.value = false
  }
})

function toggleAside() {
  if (narrow.value) asideOpen.value = !asideOpen.value
  else asideCollapsed.value = !asideCollapsed.value
}
</script>

<template>
  <UDashboardGroup unit="rem" storage="local" :storage-key="storageKey" class="flex-col">
    <header
      class="relative z-20 flex h-(--ui-header-height) shrink-0 items-center gap-3 border-b border-default bg-default px-4"
      data-shell="header"
    >
      <template v-if="narrow && headerExpanded">
        <div class="min-w-0 flex-1">
          <slot name="header" :narrow="narrow" :expanded="true" :collapse="() => (headerExpanded = false)" />
        </div>
        <UButton icon="i-lucide-x" color="neutral" variant="ghost" aria-label="Close" @click="headerExpanded = false" />
      </template>
      <template v-else>
        <UDashboardSidebarToggle class="lg:hidden" />
        <slot name="logo" :collapsed="collapsed">
          <RouterLink :to="landing" class="truncate font-semibold text-highlighted">{{ application.title }}</RouterLink>
        </slot>
        <div class="flex min-w-0 flex-1 justify-center">
          <slot v-if="!narrow" name="header" :narrow="false" :expanded="false" :collapse="() => {}" />
        </div>
        <div class="flex shrink-0 items-center gap-2">
          <slot name="actions" :narrow="narrow" :expand-header="() => (headerExpanded = true)" :account="account">
            <UDropdownMenu v-if="hasAccount" :items="account" :content="{ align: 'end' }">
              <UButton icon="i-lucide-circle-user" color="neutral" variant="ghost" aria-label="Account" />
              <template #item-trailing="{ item }">
                <UBadge v-if="item.badge !== undefined" :label="String(item.badge)" size="sm" variant="subtle" data-shell="account-badge" />
              </template>
            </UDropdownMenu>
          </slot>
          <UButton
            v-if="slots.aside && narrow"
            icon="i-lucide-panel-right"
            color="neutral"
            variant="ghost"
            aria-label="Show panel"
            @click="toggleAside"
          />
        </div>
      </template>
    </header>

    <div class="relative flex min-h-0 flex-1">
      <UDashboardSidebar
        :id="`${layout}-sidebar`"
        v-model:collapsed="collapsed"
        collapsible
        :collapsed-size="4"
        :default-size="16"
        :min-size="12"
        :max-size="22"
        :toggle="false"
        :ui="{ root: 'min-h-0', header: 'hidden' }"
      >
        <template #default="{ collapsed: isCollapsed }">
          <UNavigationMenu
            v-model="openItems"
            :items="primary"
            orientation="vertical"
            :collapsed="isCollapsed"
            tooltip
            popover
            aria-label="Main"
          />
        </template>
      </UDashboardSidebar>

      <UDashboardPanel :id="`${layout}-main`" :ui="{ root: 'min-h-0' }">
        <div class="relative flex min-h-0 flex-1 flex-col">
          <UTooltip :text="collapsed ? 'Expand menu' : 'Collapse menu'" :content="{ side: 'right' }">
            <UButton
              class="absolute top-1/2 left-0 z-10 hidden -translate-x-1/2 -translate-y-1/2 rounded-full lg:inline-flex"
              size="xs"
              color="neutral"
              variant="outline"
              :icon="collapsed ? 'i-lucide-chevron-right' : 'i-lucide-chevron-left'"
              :aria-label="collapsed ? 'Expand menu' : 'Collapse menu'"
              :aria-expanded="!collapsed"
              data-shell="sidebar-toggle"
              @click="collapsed = !collapsed"
            />
          </UTooltip>
          <div class="flex min-h-0 flex-1 flex-col overflow-y-auto">
            <main class="flex-1 p-4 sm:p-6">
              <slot>
                <RouterView />
              </slot>
            </main>
            <footer v-if="slots.footer || hasFooter" class="border-t border-default px-4 py-3 sm:px-6">
              <slot name="footer" :items="footer">
                <UNavigationMenu :items="footer" orientation="horizontal" aria-label="Footer" />
              </slot>
            </footer>
          </div>
          <UTooltip v-if="slots.aside" :text="asideCollapsed ? 'Show panel' : 'Hide panel'" :content="{ side: 'left' }">
            <UButton
              class="absolute top-1/2 right-0 z-10 hidden translate-x-1/2 -translate-y-1/2 rounded-full lg:inline-flex"
              size="xs"
              color="neutral"
              variant="outline"
              :icon="asideCollapsed ? 'i-lucide-chevron-left' : 'i-lucide-chevron-right'"
              :aria-label="asideCollapsed ? 'Show panel' : 'Hide panel'"
              :aria-expanded="!asideCollapsed"
              data-shell="aside-toggle"
              @click="toggleAside"
            />
          </UTooltip>
          <UBadge
            v-if="slots.aside && asideBadge !== undefined && asideCollapsed"
            :label="String(asideBadge)"
            color="error"
            size="sm"
            class="absolute top-1/2 right-0 z-20 hidden -translate-y-7 translate-x-1/2 rounded-full lg:inline-flex"
            data-shell="aside-badge"
          />
        </div>
      </UDashboardPanel>

      <UDashboardPanel
        v-if="slots.aside && wide && !asideCollapsed"
        :id="`${layout}-aside`"
        :default-size="22"
        :min-size="16"
        :max-size="32"
        resizable
        :ui="{ root: 'min-h-0', body: 'p-0 sm:p-0' }"
      >
        <template #body>
          <aside class="flex min-h-0 flex-1 flex-col" data-shell="aside">
            <slot name="aside" :close="() => (asideCollapsed = true)" />
          </aside>
        </template>
      </UDashboardPanel>
    </div>

    <USlideover v-if="slots.aside && narrow" v-model:open="asideOpen" side="right" title="Panel" :ui="{ body: 'p-0 sm:p-0' }">
      <template #body>
        <aside class="flex min-h-0 flex-1 flex-col" data-shell="aside">
          <slot name="aside" :close="() => (asideOpen = false)" />
        </aside>
      </template>
    </USlideover>
  </UDashboardGroup>
</template>
