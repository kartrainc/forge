<script setup lang="ts">
// The profile page extra (extras: [profile]): the signed-in user as the auth contract reports it. Generated by forge.
import { computed } from 'vue'
import { useApplicationAuth } from '@/shared/application/context'

const auth = useApplicationAuth()
const fields = computed(() => {
  const user = auth.user.value
  if (!user || typeof user !== 'object') return []
  return Object.entries(user as Record<string, unknown>)
    .filter(([, value]) => value !== null && value !== undefined && value !== '')
    .map(([key, value]) => ({ key, value: Array.isArray(value) ? value.join(', ') : String(value) }))
})
</script>

<template>
  <div class="space-y-6">
    <h1 class="text-2xl font-semibold text-highlighted">Profile</h1>
    <UCard>
      <dl class="space-y-2 text-sm">
        <div v-for="field in fields" :key="field.key" class="flex justify-between gap-4">
          <dt class="text-muted">{{ field.key }}</dt>
          <dd class="font-medium break-all">{{ field.value }}</dd>
        </div>
      </dl>
    </UCard>
    <UButton label="Sign out" icon="i-lucide-log-out" color="neutral" variant="outline" @click="auth.signOut()" />
  </div>
</template>
