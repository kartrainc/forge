/**
 * forge's authentication runtime (`auth.runtime: forge`) as the application's contract:
 * `useAuth` against the gateway's session. Generated by forge.
 */
import { persistPostLoginRedirect, useAuth } from '@/shared/composables/useAuth'
import type { AuthContract } from './contracts'

export function forgeAuth(): AuthContract {
  const auth = useAuth()
  return {
    isAuthenticated: auth.isAuthenticated,
    isLoading: auth.isLoading,
    user: auth.user,
    hasRole: role => auth.hasRole(role),
    init: () => auth.init(),
    signIn: (redirect) => {
      if (redirect) persistPostLoginRedirect(redirect)
      auth.login(redirect)
    },
    signOut: () => auth.logout(),
  }
}
