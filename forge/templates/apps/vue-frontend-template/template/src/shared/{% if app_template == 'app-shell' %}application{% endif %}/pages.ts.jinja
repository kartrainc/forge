// The pages forge renders for this app: the built-in system pages and the page extras.
// Generated by forge from frontend.routing and frontend.extras (ADR-015).
import type { Component } from 'vue'
import type { RoutingKey } from './contracts'

type Page = () => Promise<Component>

export const systemPages: Partial<Record<RoutingKey, Page>> = {
{%- for page in builtin_pages.split(',') if page %}
{%- if page == 'sign_in' %}
  sign_in: () => import('@/shared/system/SignInPage.vue'),
{%- elif page == 'not_found' %}
  not_found: () => import('@/shared/system/NotFoundPage.vue'),
{%- elif page == 'auth_stuck' %}
  auth_stuck: () => import('@/shared/system/AuthStuckPage.vue'),
{%- elif page == 'forbidden' %}
  forbidden: () => import('@/shared/system/ForbiddenPage.vue'),
{%- endif %}
{%- endfor %}
}

export const extraPages: Record<string, Page> = {
{%- if 'home' in extras.split(',') %}
  home: () => import('@/shared/pages/HomePage.vue'),
{%- endif %}
{%- if 'profile' in extras.split(',') %}
  profile: () => import('@/shared/pages/ProfilePage.vue'),
{%- endif %}
{%- if 'settings' in extras.split(',') %}
  settings: () => import('@/shared/pages/SettingsPage.vue'),
{%- endif %}
}
