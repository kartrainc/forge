// First import: it configures zod before any schema is built.
{%- if ui_kit == 'nuxt-ui' %}
import { cspNonce } from './providers/csp'
{%- else %}
import './providers/csp'
{%- endif %}
import { createApp } from 'vue'
import { createPinia } from 'pinia'
import { VueQueryPlugin } from '@tanstack/vue-query'
{%- if ui_kit == 'nuxt-ui' %}
import ui from '@nuxt/ui/vue-plugin'
{%- endif %}

import App from './App.vue'
import router from './router'
import { queryClient } from './providers/query-client'
{%- if ui_kit == 'nuxt-ui' %}
import { createAppHead } from './providers/head'
{%- endif %}
import { useAuth } from '@/shared/composables/useAuth'
import { configureApiClient } from '@/shared/api/client'
{%- if ui_kit == 'shadcn' %}
import { useSettingsStore } from '@/shared/stores/settings.store'
{%- endif %}

import './styles/main.css'

async function bootstrap() {
  // Start MSW in development when enabled
  if (import.meta.env.DEV && import.meta.env.VITE_MSW_ENABLED === 'true') {
    const { worker } = await import('@/shared/mocks/browser')
    await worker.start({ onUnhandledFrame: 'bypass' })
  }

  const app = createApp(App)
  const pinia = createPinia()

  app.use(pinia)
  app.use(router)
  app.use(VueQueryPlugin, { queryClient })
{%- if ui_kit == 'nuxt-ui' %}
  // Nuxt UI renders its palette through the head installed before it.
  app.use(createAppHead(cspNonce()))
  app.use(ui)
{%- endif %}

  // Initialize auth (handles VITE_AUTH_DISABLED internally)
  const auth = useAuth()
  await auth.init()

{%- if include_auth %}
  // Wire auth into API client (Gatekeeper uses HttpOnly cookies, no Bearer token needed)
  configureApiClient({
    getToken: async () => null,
    onUnauthorized: () => {
      auth.login()
    },
  })
{%- else %}
  // Configure API client (no auth)
  configureApiClient({
    getToken: async () => null,
    onUnauthorized: () => {},
  })
{%- endif %}
{%- if ui_kit == 'shadcn' %}

  // Apply stored theme
  const settingsStore = useSettingsStore()
  settingsStore.applyTheme()

  // Listen for system theme changes
  window
    .matchMedia('(prefers-color-scheme: dark)')
    .addEventListener('change', () => {
      if (settingsStore.theme === 'system') {
        settingsStore.applyTheme()
      }
    })
{%- endif %}

  app.mount('#app')
}

bootstrap()
