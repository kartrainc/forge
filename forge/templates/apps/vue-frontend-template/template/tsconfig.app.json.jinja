{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
{%- if ui_kit == 'nuxt-ui' %}
      "#build/ui/*": ["./node_modules/.nuxt-ui/ui/*"]
{%- else %}
      "@forge/canvas-core": ["./src/features/ai_chat/canvas-core/index.ts"]
{%- endif %}
    },
    "types": ["vite/client"]
  },
  "include": [
    "env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
{%- if ui_kit == 'nuxt-ui' %}
    "src/auto-imports.d.ts",
    "src/components.d.ts"
{%- else %}
    "src/auto-imports.d.ts"
{%- endif %}
  ],
  "exclude": [
    "src/**/__tests__/*",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts"
  ]
}
