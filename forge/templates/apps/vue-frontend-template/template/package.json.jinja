{
  "name": "{{ project_slug }}",
  "private": true,
  "version": "{{ version }}",
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
{%- if include_openapi %}
    "codegen": "openapi-ts",
{%- endif %}
    "dev": "vite",
{%- if ui_kit == 'nuxt-ui' %}
    "build": "vite build && npm run type-check",
{%- else %}
    "build": "npm run type-check && vite build",
{%- endif %}
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
{%- if include_chat %}
    "@ag-ui/client": "^{{ ag_ui_client_version }}",
    "@ag-ui/core": "^{{ ag_ui_core_version }}",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "fast-json-patch": "^3.1.1",
    "dompurify": "^3.4.17",
    "marked": "^18.1.0",
    "shiki": "^4.5.0",
{%- endif %}
{%- if include_sentry %}
    "@sentry/vue": "^11.6.0",
{%- endif %}
{%- if include_dag_editor %}
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "dagre": "^0.8.5",
{%- endif %}
{%- if ui_kit == 'nuxt-ui' %}
    "@iconify-json/lucide": "^1.2.145",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@nuxt/ui": "^{{ nuxt_ui_version }}",
    "@tanstack/vue-query": "^5.104.1",
    "@tanstack/vue-virtual": "^3.13.39",
    "@unhead/vue": "^3.4.3",
    "@vueuse/core": "^15.0.0",
    "ky": "^2.1.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "zod": "^4.6.5"
{%- else %}
    "@microsoft/fetch-event-source": "^2.0.1",
    "@tanstack/vue-query": "^5.104.1",
    "@tanstack/vue-table": "^9.2.7",
    "@tanstack/vue-virtual": "^3.13.39",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ky": "^2.1.0",
    "@lucide/vue": "^1.53.0",
    "pinia": "^4.0.3",
    "radix-vue": "^1.9.17",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.6.5"
{%- endif %}
  },
  "overrides": { "vitest": "5.0.3", "cookie@<0.7.0": "0.7.2", "js-yaml@>=4.0.0 <4.3.2": "4.3.2" },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
{%- if include_openapi %}
    "prettier": "^3.9.9",
    "@hey-api/openapi-ts": "0.99.0",
{%- endif %}
{%- if include_dag_editor %}
    "@types/dagre": "^0.7.54",
{%- endif %}
    "@playwright/test": "^1.64.0",
{%- if ui_kit == 'shadcn' %}
    "@tailwindcss/vite": "^4.3.3",
{%- endif %}
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.15.3",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
{%- if ui_kit == 'shadcn' %}
    "autoprefixer": "^10.6.1",
{%- endif %}
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "msw": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
{%- if ui_kit == 'shadcn' %}
    "unplugin-auto-import": "^21.1.0",
{%- endif %}
    "vite": "^8.3.4",
    "vitest": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-source-maps": "^5.0.6",
    "@types/istanbul-lib-instrument": "^1.7.8",
    "istanbul-lib-instrument": "^6.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  }
}
