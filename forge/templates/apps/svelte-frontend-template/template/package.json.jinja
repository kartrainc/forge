{
  "name": "{{ project_slug }}",
  "private": true,
  "version": "{{ version }}",
  "type": "module",
  "engines": { "node": ">=26.0.0" },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#canvas-core": "./src/lib/features/chat/canvas-core/index.ts"
  },
  "scripts": {
    {%- if include_openapi %}
    "codegen": "openapi-ts",
    {%- endif %}
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint ."
  },
  "dependencies": {
    {%- if include_chat %}
    "@ag-ui/client": "^{{ ag_ui_client_version }}",
    "@ag-ui/core": "^{{ ag_ui_core_version }}",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "fast-json-patch": "^3.1.1",
    "marked": "^18.1.0",
    "dompurify": "^3.4.16",
    {%- endif %}
    "@tanstack/svelte-query": "^6.3.1",
    "bits-ui": "^2.19.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ky": "^2.1.0",
    "@lucide/svelte": "^1.53.0",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "overrides": { "vitest": "5.0.5", "cookie@<0.7.0": "0.7.2", "js-yaml@>=4.0.0 <4.3.2": "4.3.2" },
  "devDependencies": {
    "globals": "^17.13.0",
    {%- if include_openapi %}
    "prettier": "^3.9.9",
    "@hey-api/openapi-ts": "^0.99.0",
    {%- endif %}
    "@playwright/test": "^1.64.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.0",
    "jsdom": "^30.1.2",
    "msw": "^3.0.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-source-maps": "^5.0.6",
    "@types/istanbul-lib-instrument": "^1.7.8",
    "istanbul-lib-instrument": "^6.0.3"
  },
  "msw": {
    "workerDirectory": [
      "static"
    ]
  }
}