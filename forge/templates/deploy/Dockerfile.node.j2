{% if dev_server %}
# -- Dependencies stage --
FROM node:22-slim AS deps
{% else %}
# -- Build stage --
FROM node:22-slim AS builder
{% endif %}
WORKDIR /app

{% if package_manager == "pnpm" %}
{% if dev_server %}
# The dev stage runs as an unprivileged user, which cannot read root's corepack
# cache: keep pnpm where every user can.
ENV COREPACK_HOME=/usr/local/share/corepack
{% endif %}
# pnpm 10, not `latest`: the lockfile is written on the host by the pnpm that is installed
# there, and newer majors refuse a lockfile that names versions younger than their
# minimumReleaseAge, so the frozen install below failed for a freshly generated project.
RUN corepack enable && corepack prepare pnpm@10 --activate
{% elif package_manager == "yarn" %}
RUN corepack enable
{% elif package_manager == "bun" %}
RUN npm install -g bun
{% endif %}

{% if package_manager == "pnpm" %}
COPY package.json pnpm-lock.yaml* ./
# Frozen install when the committed lockfile is present (reproducible);
# fall back to a resolving install when it's absent (project generated on
# a host without pnpm, so forge couldn't resolve one).
RUN if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; else pnpm install; fi
{% elif package_manager == "yarn" %}
COPY package.json yarn.lock* ./
RUN if [ -f yarn.lock ]; then yarn install --frozen-lockfile; else yarn install; fi
{% elif package_manager == "bun" %}
COPY package.json bun.lockb* ./
RUN if [ -f bun.lockb ]; then bun install --frozen-lockfile; else bun install; fi
{% else %}
COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi
{% endif %}

{% if dev_server %}
# The dev server writes Vite's cache and its bundled config into node_modules
# at startup; those directories (and /app) belong to the unprivileged user, the
# installed packages stay root's.
RUN mkdir -p node_modules/.vite node_modules/.vite-temp \
 && chown node:node /app node_modules node_modules/.vite node_modules/.vite-temp

# -- Source stage --
# The one place the application is copied, so the dev and production images
# cannot differ in what they hold.
FROM deps AS source
COPY --chown=node:node . .

# -- Dev stage --
# docker-compose.dev.yaml builds this target; sync keeps /app in step with the
# project (docker compose up --watch).
FROM source AS dev
USER node
EXPOSE {{ server_port }}
{% if package_manager == "npm" %}
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--config", "vite.dev.config.ts"]
{% else %}
CMD ["{{ package_manager }}", "run", "dev", "--host", "0.0.0.0", "--config", "vite.dev.config.ts"]
{% endif %}

# -- Build stage --
FROM source AS builder
RUN {{ package_manager }} run build
{% else %}
COPY . .
RUN {{ package_manager }} run build
{% endif %}

# -- Runtime stage --
FROM nginx:alpine

COPY --from=builder /app/{{ build_dir }} /usr/share/nginx/html
# nginx.conf is NOT baked into the image — it is supplied at runtime: a
# bind-mount in docker-compose, a ConfigMap in the Helm chart. This keeps the
# routing config a deployment concern (overridable per environment) rather than
# a build-time constant.

EXPOSE 80
