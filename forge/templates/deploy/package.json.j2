{
  "name": "{{ project_slug }}-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for {{ project_name }} — orchestrates per-service builds and pre-builds in-tree SDKs (packages/*).",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": "{{ node_engine }}"
  },
  "overrides": {
    "cookie@<0.7.0": "0.7.2",
    "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
    "@prisma/config": { "deepmerge-ts": "^8.0.0" },
    "vitest": "5.0.5",
    "mysql2": "3.24.5"
  }
}
