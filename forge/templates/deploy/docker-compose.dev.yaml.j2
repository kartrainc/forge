# Hot-reload overlay for the frontend (ADR-013). Generated by forge.
#
#   docker compose -f docker-compose.yml -f docker-compose.dev.yaml up --build --watch
#
# Replaces the nginx `frontend` service with a Vite dev server behind the same
# Traefik router and host. Needs Docker Compose 2.39.4 or newer. It serves no
# content-security policy and does not route the gatekeeper's sign-in paths:
# check both on the built image.
services:
  frontend:
    build:
      target: dev
    volumes: !reset []
    # Only the port the router targets changes. Labels merge key by key, so the rule,
    # the entrypoint and any host another overlay added to the router stay as they are.
    labels:
      traefik.http.services.frontend.loadbalancer.server.port: "{{ frontend_port }}"
    healthcheck: !override
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:{{ frontend_port }}/').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
      interval: 5s
      timeout: 5s
      retries: 12
      start_period: 20s
    develop:
      watch:
        # The project is copied in as it changes. Vite restarts itself when its
        # config, its imports or an .env file change. What the install owns
        # stays in the image, and the files Vite generates at startup stay in
        # the container, so nothing the container writes lands in the checkout.
        - action: sync
          path: ./apps/{{ frontend_slug }}
          target: /app
          initial_sync: true
          ignore:
            - node_modules
            - dist
            - coverage
            - package.json
            - {{ lockfile }}
            - src/auto-imports.d.ts
            - src/components.d.ts
        # A changed dependency list needs a new image.
        - action: rebuild
          path: ./apps/{{ frontend_slug }}/package.json
        - action: rebuild
          path: ./apps/{{ frontend_slug }}/{{ lockfile }}
