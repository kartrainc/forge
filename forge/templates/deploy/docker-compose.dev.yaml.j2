# Hot-reload overlay for the frontend (ADR-013). Generated by forge.
#
#   docker compose -f docker-compose.yml -f docker-compose.dev.yaml up --build --watch
#
# Replaces the nginx service of each frontend that has `dev_server` with a Vite dev
# server behind the same Traefik router and host. Needs Docker Compose 2.39.4 or newer.
# It serves no content-security policy and does not route the gatekeeper's sign-in
# paths: check both on the built image.
services:
{% for app in apps %}
  {{ app.service }}:
    build:
      target: dev
    # Its own image name: the base file builds the nginx image under the service's default
    # name, and one tag for both would let a later `up` without --build start the wrong one.
    image: {{ image_prefix }}-{{ app.service }}-dev
    volumes: !reset []
    # The browser calls the API on the page's own origin, through the router. The project's
    # .env.development points at the dev server's port, which nothing publishes here, and
    # the process environment wins over .env files.
    environment:
      VITE_API_BASE_URL: ""
    # A host another overlay adds to the router's rule must also go in
    # FORGE_DEV_ALLOWED_HOSTS (comma-separated) on this service, or Vite answers 403.
    # Only the port the router targets changes. Labels merge key by key, so the rule,
    # the entrypoint and any host another overlay added to the router stay as they are.
    labels:
      traefik.http.services.{{ app.service }}.loadbalancer.server.port: "{{ app.port }}"
    healthcheck: !override
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:{{ app.port }}/').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
      interval: 5s
      timeout: 5s
      retries: 12
      start_period: 20s
    develop:
      watch:
        # The app is copied in as it changes. Vite restarts itself when its config,
        # its imports or an .env file change. What the install owns stays in the
        # image, and the files Vite generates at startup stay in the container, so
        # nothing the container writes lands in the checkout.
        - action: sync
          path: ./apps/{{ app.name }}
          target: /app
          initial_sync: true
          ignore:
            - node_modules
            - dist
            - coverage
            - package.json
{% for name in app.ignore_lockfiles %}
            - {{ name }}
{% endfor %}
            - src/auto-imports.d.ts
            - src/components.d.ts
        # A changed dependency list needs a new image.
        - action: rebuild
          path: ./apps/{{ app.name }}/package.json
        - action: rebuild
          path: ./apps/{{ app.name }}/{{ app.lockfile }}
{% endfor %}
