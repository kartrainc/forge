# Hot-reload overlay for the frontend (ADR-013). Generated by forge.
#
#   docker compose -f docker-compose.yml -f docker-compose.dev.yaml up --build --watch
#
# Replaces the nginx `frontend` service with a Vite dev server behind the same
# Traefik router and host. Needs Docker Compose 2.40 or newer. It serves no
# content-security policy and does not route the gatekeeper's sign-in paths:
# check both on the built image.
services:
  frontend:
    build:
      target: dev
    volumes: !reset []
    labels: !override
      - "traefik.enable=true"
      - "traefik.http.routers.frontend.rule=Host(`app.localhost`)"
      - "traefik.http.routers.frontend.entrypoints=web"
      - "traefik.http.services.frontend.loadbalancer.server.port={{ frontend_port }}"
    healthcheck: !override
      test: ["CMD", "node", "-e", "fetch('http://127.0.0.1:{{ frontend_port }}/').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]
      interval: 5s
      timeout: 5s
      retries: 12
      start_period: 20s
    develop:
      watch:
        # The source tree is copied in; the files the dev server generates
        # (Vite writes them at startup) stay in the container.
        - action: sync
          path: ./apps/{{ frontend_slug }}/src
          target: /app/src
          initial_sync: true
          ignore:
            - auto-imports.d.ts
            - components.d.ts
        - action: sync
          path: ./apps/{{ frontend_slug }}/index.html
          target: /app/index.html
          initial_sync: true
        # Vite reads these once at startup.
        - action: sync+restart
          path: ./apps/{{ frontend_slug }}/vite.config.ts
          target: /app/vite.config.ts
          initial_sync: true
        - action: sync+restart
          path: ./apps/{{ frontend_slug }}/vite.dev.config.ts
          target: /app/vite.dev.config.ts
          initial_sync: true
        - action: sync+restart
          path: ./apps/{{ frontend_slug }}/scripts
          target: /app/scripts
          initial_sync: true
        - action: sync+restart
          path: ./apps/{{ frontend_slug }}/.env.development
          target: /app/.env.development
          initial_sync: true
        # A changed dependency list needs a new image.
        - action: rebuild
          path: ./apps/{{ frontend_slug }}/package.json
        - action: rebuild
          path: ./apps/{{ frontend_slug }}/{{ lockfile }}
