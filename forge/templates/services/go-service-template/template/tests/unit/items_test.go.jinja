func TestUpdateConflictsAndVanishingRows(t *testing.T) {
	ctx, dev := context.Background(), identity.Dev()
	repo := newMemoryRepo()
	service := services.NewItemService(vanishing{repo})
	item, _ := repo.Create(ctx, dev, models.CreateItem{Name: "one"})
	name := "two"
	if _, err := service.Update(ctx, dev, item.ID, models.UpdateItem{Name: &name}); apperrors.As(err).Code != apperrors.NotFound {
		t.Fatalf("vanished row: %v", err)
	}
	conflicting := services.NewItemService(failingExcluding{repo})
	if _, err := conflicting.Update(ctx, dev, item.ID, models.UpdateItem{Name: &name}); !errors.Is(err, errNames) {
		t.Fatalf("lookup failure: %v", err)
	}
	broken := services.NewItemService(failingUpdate{repo})
	if _, err := broken.Update(ctx, dev, item.ID, models.UpdateItem{Name: &name}); !errors.Is(err, errNames) {
		t.Fatalf("update failure: %v", err)
	}
}

