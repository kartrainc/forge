# docker-compose fragment for the {{ project_slug }} Go service. Mirrors the
# Python, Node and Rust templates so platform-level orchestration is uniform
# across language backends.

services:
  {{ project_slug }}-migrate:
    build:
      context: ./services/{{ project_slug }}
      dockerfile: Dockerfile
      additional_contexts:
        project_root: .
        packages: ./packages
    environment:
      ENV: development
      DATABASE_URL: "postgres://postgres:postgres@postgres:5432/{{ db_name }}"
    command: ["/app/migrate"]
    depends_on:
      postgres:
        condition: service_healthy
    networks: [app-network]

  {{ project_slug }}:
    build:
      context: ./services/{{ project_slug }}
      dockerfile: Dockerfile
      additional_contexts:
        project_root: .
        packages: ./packages
    ports:
      - "{{ server_port }}:{{ server_port }}"
    environment:
      # The dev stack overrides the image's ENV=production so the startup auth
      # guard does not abort boot without GATEKEEPER_ISSUER/SERVICE_AUDIENCE.
      ENV: development
      PORT: "{{ server_port }}"
      DATABASE_URL: "postgres://postgres:postgres@postgres:5432/{{ db_name }}"
      OTEL_EXPORTER_OTLP_ENDPOINT: "http://alloy:4318"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.{{ project_slug }}.rule=Host(`app.localhost`) && PathPrefix(`/api/{{ project_slug }}`)"
      - "traefik.http.routers.{{ project_slug }}.middlewares={{ project_slug }}-rewrite"
      - "traefik.http.middlewares.{{ project_slug }}-rewrite.replacepathregex.regex=^/api/{{ project_slug }}/(.*)"
      - "traefik.http.middlewares.{{ project_slug }}-rewrite.replacepathregex.replacement=/api/$$1"
      - "traefik.http.services.{{ project_slug }}.loadbalancer.server.port={{ server_port }}"
    depends_on:
      {{ project_slug }}-migrate:
        condition: service_completed_successfully
      keycloak:
        condition: service_healthy
    networks: [app-network]
