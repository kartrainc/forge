import { defineConfig } from "vitest/config";

// Vitest config — defaults the ``test`` script (and the matrix-verify
// lane's ``vitest run``) to unit tests only. Integration tests under
// ``tests/integration/`` require running infra (postgres, gatekeeper,
// keycloak) and run in the docker-compose-driven smoke lane instead.
//
// Run integration tests with ``npm run test:integration`` once your
// local ``docker compose up`` stack is healthy.

export default defineConfig({
  test: {
    include: ["tests/unit/**/*.test.ts", "src/**/*.test.ts"],
    exclude: ["**/node_modules/**", "tests/integration/**"],
    environment: "node",
    globals: false,
    passWithNoTests: false,
    // CI prints the console of failing tests only: a runner's log slows down on large output
    silent: /^(1|true)$/i.test(process.env.CI ?? "") ? "passed-only" : false,
    env: { NODE_ENV: "testing" },
    coverage: {
      provider: "v8",
      include: ["src/**/*.ts", "../../packages/*/src/**/*.ts", "packages/*/src/**/*.ts"],
      allowExternal: true,
      exclude: ["**/*.test.ts", "**/*.d.ts"],
      reporter: ["json", "lcov", "text"],
    },
  },
});
